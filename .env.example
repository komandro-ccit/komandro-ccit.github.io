# Contoh .env untuk development lokal.
# Salin jadi .env lalu isi nilai sebenarnya (jangan commit .env!).

# Project URL Supabase (Settings > API)
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon public key (client-safe, dipakai sebagai header apikey)
PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Hanya untuk scripts/seed & upload foto — JANGAN beri prefix PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
