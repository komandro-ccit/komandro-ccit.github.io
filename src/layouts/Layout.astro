---
import Navbar from '../components/Navbar.astro';
import { link } from '../utils/link';

interface Props {
  title: string;
  description?: string;
  /** Path gambar share (default /og-image.png 1200x630). */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  /** Tag artikel (hanya dipakai kalau type="article"). */
  tags?: string[];
  noindex?: boolean;
}

const SITE_NAME = 'Komandro CCIT-FTUI';
const SITE_DESCRIPTION = 'Komandro CCIT-FTUI - Komunitas Android dan Teknologi sejak 2015. Belajar, Berkarya, Berkomunitas.';

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og-image.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = SITE_NAME,
  tags = [],
  noindex = false
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://komandro-ccit.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const imageAlt = title;
const isDefaultImage = image === '/og-image.png';
const imageType = /\.jpe?g$/i.test(imageURL.pathname)
  ? 'image/jpeg'
  : /\.webp$/i.test(imageURL.pathname)
    ? 'image/webp'
    : /\.svg$/i.test(imageURL.pathname)
      ? 'image/svg+xml'
      : 'image/png';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  alternateName: 'Komandro',
  url: siteURL.href,
  logo: new URL('/icon-512.png', siteURL).href,
  image: new URL('/og-image.png', siteURL).href,
  description: SITE_DESCRIPTION,
  email: 'komandro@ccit-ftui.ac.id',
  foundingDate: '2015',
  sameAs: [
    'https://instagram.com/komandro_ccit',
    'https://github.com/komandro-ccit'
  ],
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'CCIT - Fakultas Teknik Universitas Indonesia'
  }
};

const articleData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: imageURL.href,
      author: { '@type': 'Person', name: author },
      publisher: { '@type': 'Organization', name: SITE_NAME, logo: structuredData.logo },
      mainEntityOfPage: canonicalURL.href,
      ...(publishedTime ? { datePublished: new Date(publishedTime).toISOString() } : {}),
      ...(modifiedTime
        ? { dateModified: new Date(modifiedTime).toISOString() }
        : publishedTime
          ? { dateModified: new Date(publishedTime).toISOString() }
          : {})
    }
  : null;

const currentYear = new Date().getFullYear();

const footerNav = [
  {
    heading: 'Belajar',
    links: [
      { label: 'Semua Materi', href: '/material' },
      { label: 'Mobile', href: '/material/mobile' },
      { label: 'Web', href: '/material/web' },
      { label: 'DevOps', href: '/material/devops' }
    ]
  },
  {
    heading: 'Komunitas',
    links: [
      { label: 'Tentang Kami', href: '/about' },
      { label: 'Anggota', href: '/members' },
      { label: 'Program Kerja', href: '/program-kerja' },
      { label: 'Alumni', href: '/alumni' }
    ]
  },
  {
    heading: 'Kontak',
    links: [
      { label: 'komandro@ccit-ftui.ac.id', href: 'mailto:komandro@ccit-ftui.ac.id' },
      { label: 'Instagram', href: 'https://instagram.com/komandro_ccit' },
      { label: 'GitHub', href: 'https://github.com/komandro-ccit' }
    ]
  }
];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Komandro CCIT-FTUI" />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Favicon & app icon (dibuat oleh scripts/build-brand-assets.py) -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Komandro CCIT" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Komandro CCIT" />
    <meta name="theme-color" content="#FFF9F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A1927" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:type" content={imageType} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}
    {type === 'article' && <meta property="article:author" content={author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {articleData && <script type="application/ld+json" set:html={JSON.stringify(articleData)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Box Icons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        line-height: 1.65;
        color: #2A2340;
        background-color: #FFF9F3;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      .prose {
        overflow-wrap: break-word;
        word-break: break-word;
      }

      .prose pre {
        overflow-x: auto;
        max-width: 100%;
      }

      .prose img {
        max-width: 100%;
        height: auto;
      }

      /* Aksesibilitas: reduksi motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <slot name="navbar">
      <Navbar />
    </slot>
    <slot />

    <!-- Global Footer -->
    <footer class="relative bg-ink-band text-white overflow-hidden">
      <span class="pointer-events-none absolute -top-24 -right-16 w-[280px] h-[280px] rounded-full bg-violet/25 blur-3xl" aria-hidden="true"></span>
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">
          <div class="md:col-span-6">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-[13px] bg-gradient-to-br from-violet to-pink grid place-items-center -rotate-6" aria-hidden="true">
                <img src="/brand/logo-emblem-white.png" alt="" width="30" height="20" class="w-[30px] h-auto" decoding="async" />
              </div>
              <span class="font-display font-bold text-[21px] tracking-tight">Komandro</span>
            </div>
            <p class="text-white/70 text-body-sm max-w-sm leading-relaxed mb-8">
              Komunitas Android &amp; Teknologi CCIT-FTUI. Belajar, berkarya, berkembang bareng sejak 2015.
            </p>
            <div class="flex gap-3">
              <a href="https://instagram.com/komandro_ccit" target="_blank" rel="noopener noreferrer" aria-label="Instagram Komandro" class="w-10 h-10 rounded-full bg-white/10 grid place-items-center hover:bg-violet transition-colors duration-300">
                <i class="bx bxl-instagram text-[19px]"></i>
              </a>
              <a href="https://github.com/komandro-ccit" target="_blank" rel="noopener noreferrer" aria-label="GitHub Komandro" class="w-10 h-10 rounded-full bg-white/10 grid place-items-center hover:bg-violet transition-colors duration-300">
                <i class="bx bxl-github text-[19px]"></i>
              </a>
            </div>
          </div>

          {footerNav.map((col) => (
              <div class="md:col-span-2">
              <h4 class="text-[12.5px] font-bold uppercase tracking-widest text-white/45 mb-4">{col.heading}</h4>
              <ul class="space-y-2.5">
                {col.links.map((item) => (
                  <li>
                    <a href={item.href} class="text-[14.5px] text-white/75 hover:text-amber transition-colors">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="border-t border-white/12 pt-6 flex flex-col md:flex-row justify-between items-center gap-3">
          <p class="text-[13px] text-white/45">&copy; {currentYear} Komandro CCIT-FTUI. All rights reserved.</p>
          <span class="text-[13px] text-white/45">Engineering Center, CCIT-FTUI · Universitas Indonesia, Depok</span>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Efek scroll pada header ditangani Navbar sendiri
</script>

<style is:global>
  .hero-pattern {
    background-image: radial-gradient(circle at 1px 1px, rgba(42, 35, 64, 0.06) 1px, transparent 0);
    background-size: 24px 24px;
  }
</style>
