---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CTA from '../components/ui/CTA.astro';
import HeroBg from '../components/ui/HeroBg.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import membersData from '../data/members.json';

const { members } = membersData;

const roleTone: Record<string, 'violet' | 'sky' | 'mint' | 'amber' | 'neutral'> = {
  'Ketua': 'violet',
  'Wakil Ketua': 'sky',
  'Sekretaris': 'mint',
  'Bendahara': 'amber',
  'Koordinator': 'sky',
  'Staff': 'neutral'
};

const accentPool = ['violet', 'pink', 'mint', 'sky', 'amber', 'magenta', 'orange', 'lime'] as const;

const avatarBg: Record<string, string> = {
  violet: 'bg-violet', pink: 'bg-pink', mint: 'bg-mint', sky: 'bg-sky',
  amber: 'bg-amber', magenta: 'bg-magenta', orange: 'bg-orange', lime: 'bg-lime'
};
---

<Layout title="Pengurus - Komandro CCIT-FTUI">
  <main class="pt-[92px]">

    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Pengurus</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            Anggota <span class="text-violet">Aktif</span>
          </h1>
          <p class="text-body-lg text-ink-2 max-w-xl">
            Kenalan dengan tim yang sedang menggerakkan Komandro CCIT-FTUI ke depan.
          </p>
        </div>
      </div>
    </section>

    {/* Grid Anggota */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
          {members.map((member, i) => {
            const initials = member.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
            const accent = accentPool[i % accentPool.length];
            return (
              <div class="bg-canvas rounded-md p-6 text-center shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
                <div class:list={['w-20 h-20 mx-auto mb-4 rounded-[20px] grid place-items-center shadow-card-md', avatarBg[accent]]} aria-hidden="true">
                  <span class="font-display text-[22px] text-white">{initials}</span>
                </div>

                <span class:list={['inline-flex items-center px-3 h-[24px] rounded-full text-[11px] font-bold mb-3', {
                  violet: 'bg-violet-soft text-violet-deep',
                  sky: 'bg-sky-soft text-sky-deep',
                  mint: 'bg-mint-soft text-mint-deep',
                  amber: 'bg-amber-soft text-amber-deep',
                  neutral: 'bg-ink/5 text-ink-2'
                }[roleTone[member.role] ?? 'neutral']]}>
                  {member.role}
                </span>

                <h3 class="font-display text-[17px] text-ink mb-2">{member.name}</h3>

                {member.contact?.linkedin && (
                  <a
                    href={member.contact.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`LinkedIn ${member.name}`}
                    class="inline-flex items-center gap-1.5 text-[13px] font-bold text-ink-2 hover:text-violet transition-colors"
                  >
                    <i class="bx bxl-linkedin text-[16px]" aria-hidden="true"></i>
                    LinkedIn
                  </a>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="pb-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="relative overflow-hidden bg-gradient-to-br from-violet to-pink rounded-lg px-8 md:px-12 py-14 text-center text-white">
          <span class="pointer-events-none absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/12" aria-hidden="true"></span>
          <h2 class="relative font-display text-display-md md:text-display-lg mb-4 text-white">Mau Jadi Bagian Tim Ini?</h2>
          <p class="relative text-white/85 text-body-lg mb-3 max-w-xl mx-auto">
            Keanggotaan terbuka untuk mahasiswa aktif CCIT - FTUI.
          </p>
          <p class="relative text-white/85 text-body-lg mb-9 max-w-xl mx-auto">
            Hubungi kami lewat Instagram untuk tahu lebih banyak.
          </p>
          <a
            href="https://instagram.com/komandro_ccit"
            target="_blank"
            rel="noopener noreferrer"
            class="relative inline-flex items-center gap-2 bg-white text-violet-deep px-7 py-3.5 rounded-full text-[15px] font-bold hover:-translate-y-0.5 transition-all duration-300 ease-bounce shadow-card-md"
          >
            @komandro_ccit
            <i class="bx bx-right-arrow-alt text-[19px]" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
