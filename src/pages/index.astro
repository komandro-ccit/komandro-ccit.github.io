---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import CTA from '../components/ui/CTA.astro';
import HeroBg from '../components/ui/HeroBg.astro';
import { link } from '../utils/link';

const currentYear = new Date().getFullYear();
const yearsActive = currentYear - 2015;

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = blogPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const stats = [
  { value: `${yearsActive}+`, label: 'Tahun Dedikasi', accent: 'violet' },
  { value: '500+', label: 'Alumni Berprestasi', accent: 'pink' },
  { value: '50+', label: 'Workshop Teknis', accent: 'mint' },
  { value: '100+', label: 'Proyek Rekayasa', accent: 'amber' }
] as const;

const pillars = [
  {
    icon: 'bx-trophy',
    accent: 'violet',
    title: 'Rekayasa Kompetitif',
    description: 'Berbagai kemenangan kompetisi nasional maupun internasional yang membuktikan kemampuan luar biasa di bidang pengembangan mobile dan software engineering.'
  },
  {
    icon: 'bx-briefcase',
    accent: 'pink',
    title: 'Karier Profesional',
    description: 'Alumni yang menapaki karier terkemuka di perusahaan teknologi global dan startup inovatif, meneruskan ketelitian khas Komandro.'
  },
  {
    icon: 'bx-buildings',
    accent: 'mint',
    title: 'Integrasi Industri',
    description: 'Kemitraan strategis dengan perusahaan teknologi terdepan untuk riset lanjutan, magang, dan pengembangan kurikulum.'
  }
] as const;

const directory = [
  {
    icon: 'bx-map-pin',
    accent: 'violet',
    label: 'Lokasi Kampus',
    name: 'Engineering Center',
    detail: 'Fakultas Teknik<br/>Universitas Indonesia<br/>Depok, Jawa Barat 16424'
  },
  {
    icon: 'bx-desktop',
    accent: 'sky',
    label: 'Fasilitas',
    name: 'Laboratorium Komputer',
    detail: 'Lantai 2<br/>Gedung Engineering Center'
  },
  {
    icon: 'bx-time-five',
    accent: 'mint',
    label: 'Jadwal Rutin',
    name: 'Rapat Mingguan',
    detail: 'Kamis, 16:00 - 18:00 WIB'
  }
] as const;
---

<Layout title="Komandro | CCIT-FTUI Android & Technology Community">
  <main class="pt-[92px]">

    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="relative z-10 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="max-w-3xl flex flex-col items-start">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet animate-pulse" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Berdiri 2015 · Komunitas Teknologi</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-6">
            Menumbuhkan Generasi <span class="relative text-violet">Teknologi<svg class="absolute left-0 -bottom-1 w-full h-[14px]" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 10 C60 2, 140 2, 198 9" stroke="#FFB020" stroke-width="7" fill="none" stroke-linecap="round" opacity=".45"/></svg></span> Masa Depan
          </h1>
          <p class="text-body-lg text-ink-2 max-w-2xl mb-9">
            Komunitas Android &amp; Teknologi CCIT-FTUI. Kami adalah komunitas yang mendedikasikan diri pada kemajuan praktik rekayasa perangkat lunak, mendorong inovasi, dan membangun jaringan profesional teknologi yang prestisius.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <CTA href="/material" label="Jelajahi Program" variant="primary" arrow />
            <CTA href="/alumni" label="Lihat Alumni" variant="ghost" />
          </div>
        </div>
      </div>
    </section>

    {/* Stats */}
    <section class="py-16 md:py-24 bg-canvas">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Dampak Komunitas"
          accent="violet"
          title="Satu dekade dedikasi untuk belajar &amp; berkarya"
          description="Sepuluh tahun konsistensi dalam pendidikan teknis, rekayasa praktis, dan pembangunan komunitas di Universitas Indonesia."
        />
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {stats.map((s) => (
            <div class:list={['rounded-[22px] py-8 md:py-10 text-center shadow-card hover:shadow-card-md transition-shadow duration-300', {
              violet: 'bg-violet-soft',
              pink: 'bg-pink-soft',
              mint: 'bg-mint-soft',
              amber: 'bg-amber-soft'
            }[s.accent]]}>
              <div class="font-display text-[38px] md:text-[48px] leading-none tracking-tight text-ink mb-3">{s.value}</div>
              <span class="text-label uppercase tracking-widest text-ink-2">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Pilar Utama */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Kepercayaan Kami"
          accent="pink"
          title="Tiga pilar yang membentuk Komandro"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {pillars.map((p) => (
            <div class="bg-canvas rounded-md p-7 shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
              <IconBadge icon={p.icon} accent={p.accent} class="mb-5" />
              <h3 class="font-display text-display-sm text-ink mb-3">{p.title}</h3>
              <p class="text-body-md text-ink-2 leading-relaxed">{p.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Direktori Komunitas */}
    <section class="py-16 md:py-24 bg-canvas">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="flex flex-col lg:flex-row justify-between items-start gap-10">
          <div class="lg:w-1/3 shrink-0">
            <SectionHeader
              kicker="Kenal Kami Lebih Dekat"
              accent="mint"
              title="Direktori Komunitas"
              description="Komandro berkedudukan di Fakultas Teknik Universitas Indonesia, menyediakan lingkungan akademik unggul untuk kemajuan teknologi."
            />
            <CTA href="https://maps.google.com/?q=Faculty+of+Engineering+Universitas+Indonesia" label="Lihat di Peta" variant="ghost" arrow />
          </div>
          <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
            {directory.map((d) => (
              <div class="bg-white rounded-md p-7 shadow-card">
                <div class="flex items-center gap-3 mb-5">
                  <IconBadge icon={d.icon} accent={d.accent} size="sm" />
                  <span class="text-label uppercase tracking-widest text-ink-3">{d.label}</span>
                </div>
                <p class="font-display text-lg text-ink mb-1.5">{d.name}</p>
                <p class="text-body-md text-ink-2 leading-relaxed" set:html={d.detail} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Blog Terbaru */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="flex flex-col md:flex-row justify-between items-start gap-6 mb-10 md:mb-14">
          <SectionHeader
            kicker="Jurnal Komunitas"
            accent="amber"
            title="Terbaru dari Blog"
            description="Berita, pembaruan, dan wawasan dari komunitas Komandro."
          />
          <a href={link('/blog')} class="hidden md:inline-flex items-center gap-2 text-[14.5px] font-bold text-ink hover:text-violet transition-colors shrink-0 self-end mb-11">
            Lihat Semua Artikel
            <i class="bx bx-right-arrow-alt text-[18px]"></i>
          </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {latestPosts.map((post) => (
            <article class="group bg-canvas rounded-md overflow-hidden shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
              {post.data.heroImage && (
                <div class="p-3 pb-0">
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async" class="w-full aspect-video object-cover rounded-[16px]" />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-2.5 mb-4 text-[12.5px] font-semibold text-ink-3">
                  <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                  <span class="w-1 h-1 rounded-full bg-ink-3" aria-hidden="true"></span>
                  <span>{post.data.author}</span>
                </div>
                <a href={link(`/blog/${post.slug}`)}>
                  <h3 class="font-display text-[19px] leading-snug text-ink mb-3 group-hover:text-violet transition-colors">{post.data.title}</h3>
                </a>
                <p class="text-body-sm text-ink-2 line-clamp-2">{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 md:hidden text-center">
          <CTA href="/blog" label="Lihat Semua Artikel" variant="ghost" arrow />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
