---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import CTA from '../components/ui/CTA.astro';
import HeroBg from '../components/ui/HeroBg.astro';
import { link } from '../utils/link';
import aboutData from '../data/about.json';

const { milestones, team } = aboutData;

const timelineAccents = ['violet', 'pink', 'mint', 'amber', 'sky', 'magenta', 'orange', 'lime'] as const;
const accentDot: Record<string, string> = {
  violet: 'bg-violet', pink: 'bg-pink', mint: 'bg-mint', amber: 'bg-amber',
  sky: 'bg-sky', magenta: 'bg-magenta', orange: 'bg-orange', lime: 'bg-lime'
};

const roleTone: Record<string, 'violet' | 'sky' | 'mint' | 'amber' | 'neutral'> = {
  'Ketua': 'violet',
  'Wakil Ketua': 'sky',
  'Sekretaris': 'mint',
  'Bendahara': 'amber'
};

const memberDash = [
  { icon: 'bx-target-lock', accent: 'violet' as const, title: 'Misi Kami', text: 'To foster a collaborative learning environment where students can develop technical skills in Android development and modern technologies, while building lasting professional networks and contributing to the tech community.' },
  { icon: 'bx-star', accent: 'pink' as const, title: 'Visi Kami', text: 'Untuk menjadi komunitas teknologi mahasiswa terdepan yang menghasilkan lulusan siap industri yang unggul di pengembangan mobile, rekayasa perangkat lunak, dan teknologi baru, berkontribusi pada transformasi digital Indonesia.' }
];

const avatarBg: Record<string, string> = {
  violet: 'bg-violet', pink: 'bg-pink', mint: 'bg-mint', sky: 'bg-sky', amber: 'bg-amber'
};
---

<Layout title="Tentang Kami - Komandro CCIT-FTUI">
  <main class="pt-[92px]">

    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Tentang</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            Tentang <span class="text-violet">Komandro</span>
          </h1>
          <p class="text-body-lg text-ink-2 max-w-2xl">
            Pelajari perjalanan kami, misi, dan komunitas yang telah kami bangun sejak 2015. Kami bermisi menumbuhkan generasi profesional teknologi berikutnya.
          </p>
        </div>
      </div>
    </section>

    {/* Misi & Visi */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Arah Kami"
          accent="violet"
          title="Misi &amp; Visi"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {memberDash.map((m) => (
            <div class="bg-canvas rounded-lg p-8 shadow-card hover:shadow-card-md transition-shadow duration-300">
              <IconBadge icon={m.icon} accent={m.accent} size="lg" class="mb-5" />
              <h3 class="font-display text-display-sm text-ink mb-3">{m.title}</h3>
              <p class="text-body-md text-ink-2 leading-relaxed">{m.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Timeline */}
    <section class="py-16 md:py-24 bg-canvas">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Perjalanan Jejak"
          accent="pink"
          title="Sejarah Komunitas"
        />

        <div class="relative max-w-3xl">
          <span class="absolute left-[10px] top-2 bottom-2 w-[3px] rounded-full bg-gradient-to-b from-violet via-pink to-mint opacity-30" aria-hidden="true"></span>
          <div class="space-y-9">
            {milestones.map((milestone, index) => {
              const accent = timelineAccents[index % timelineAccents.length];
              return (
                <div class="relative flex gap-6 pl-0">
                  <span class:list={['relative z-10 mt-1.5 w-[23px] h-[23px] rounded-full shrink-0 ring-4 ring-canvas shadow-card-md', accentDot[accent]]} aria-hidden="true"></span>
                  <div class="flex-1 pb-1">
                    <span class="font-display text-[15px] text-violet">{milestone.year}</span>
                    <h3 class="font-display text-[19px] text-ink mb-1.5 mt-0.5">{milestone.title}</h3>
                    <p class="text-body-sm md:text-body-md text-ink-2 leading-relaxed">{milestone.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    {/* Kepemimpinan */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Struktur Organisasi"
          accent="mint"
          title="Kepemimpinan Saat Ini"
        />

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {team.map((member, i) => {
            const accents = ['violet', 'pink', 'mint', 'sky', 'amber'] as const;
            const accent = accents[i % accents.length];
            return (
              <div class="bg-canvas rounded-md p-6 text-center shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
                <div class:list={['w-16 h-16 mx-auto mb-4 rounded-[18px] grid place-items-center shadow-card-md text-white font-display text-[19px]', avatarBg[accent]]} aria-hidden="true">
                  {member.name.split(' ').filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase()}
                </div>

                <h3 class="font-display text-[17px] text-ink mb-1.5">{member.name}</h3>

                <span class:list={['inline-flex items-center px-3 h-[24px] rounded-full text-[11px] font-bold mb-2', {
                  violet: 'bg-violet-soft text-violet-deep',
                  sky: 'bg-sky-soft text-sky-deep',
                  mint: 'bg-mint-soft text-mint-deep',
                  amber: 'bg-amber-soft text-amber-deep',
                  neutral: 'bg-ink/5 text-ink-2'
                }[roleTone[member.role] ?? 'neutral']]}>
                  {member.role}
                </span>

                <p class="text-[12.5px] font-semibold text-ink-3">{member.period}</p>

                {member.current && (
                  <div class="mt-3 inline-flex items-center gap-1.5 px-3 h-[26px] rounded-full bg-mint-soft text-mint-deep text-[11px] font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-mint animate-pulse" aria-hidden="true"></span>
                    Aktif
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* Lokasi */}
    <section class="py-16 md:py-24 bg-canvas">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="flex flex-col lg:flex-row justify-between items-start gap-12">
          <div class="lg:w-1/3 shrink-0">
            <SectionHeader
              kicker="Kunjungi Kami"
              accent="amber"
              title="Kampus Kami"
              description="Komandro berkedudukan di Fakultas Teknik Universitas Indonesia, menyediakan lingkungan akademik unggul untuk kemajuan teknologi."
            />
            <CTA href="https://maps.google.com/?q=Faculty+of+Engineering+Universitas+Indonesia" label="Lihat di Peta" variant="ghost" arrow />
          </div>
          <div class="lg:w-2/3 w-full">
            <div class="rounded-lg overflow-hidden shadow-card-md h-[350px] mb-10">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.184555262124!2d106.82348637590873!3d-6.362763762257183!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69ec1a90b7b85d%3A0x76f9f05a69e55d5a!2sFaculty%20of%20Engineering%20-%20Universitas%20Indonesia!5e0!3m2!1sen!2sid!4v1709899200000!5m2!1sen!2sid"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Lokasi FT UI"
              ></iframe>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-white rounded-md p-7 shadow-card">
                <div class="flex items-center gap-3 mb-4">
                  <IconBadge icon="bx-map-pin" accent="violet" size="sm" />
                  <span class="text-label uppercase tracking-widest text-ink-3">Alamat</span>
                </div>
                <p class="font-display text-lg text-ink mb-1.5">Engineering Center</p>
                <p class="text-body-md text-ink-2 leading-relaxed">
                  Fakultas Teknik<br/>Universitas Indonesia<br/>Depok, Jawa Barat 16424
                </p>
              </div>
              <div class="bg-white rounded-md p-7 shadow-card">
                <div class="flex items-center gap-3 mb-4">
                  <IconBadge icon="bx-time-five" accent="mint" size="sm" />
                  <span class="text-label uppercase tracking-widest text-ink-3">Jadwal Rapat</span>
                </div>
                <p class="font-display text-lg text-ink mb-1.5">Rapat Mingguan</p>
                <p class="text-body-md text-ink-2 leading-relaxed">
                  Setiap Kamis<br/>16:00 - 18:00 WIB
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* CTA Gabung */}
    <section class="pb-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="relative overflow-hidden bg-gradient-to-br from-violet to-pink rounded-lg px-8 md:px-12 py-14 text-center text-white">
          <span class="pointer-events-none absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/12" aria-hidden="true"></span>
          <span class="pointer-events-none absolute -bottom-20 -left-12 w-56 h-56 rounded-full bg-white/10" aria-hidden="true"></span>
          <h2 class="relative font-display text-display-md md:text-display-lg mb-4 text-white">Mau Gabung Bersama Kami?</h2>
          <p class="relative text-white/85 text-body-lg mb-3 max-w-2xl mx-auto">
            Keanggotaan terbuka untuk mahasiswa aktif CCIT - FTUI.
          </p>
          <p class="relative text-white/85 text-body-lg mb-9 max-w-2xl mx-auto">
            Hubungi kami lewat Instagram untuk tahu lebih banyak soal rekrutmen dan cara bergabung.
          </p>
          <a
            href="https://instagram.com/komandro_ccit"
            target="_blank"
            rel="noopener noreferrer"
            class="relative inline-flex items-center gap-2 bg-white text-violet-deep px-7 py-3.5 rounded-full text-[15px] font-bold hover:-translate-y-0.5 transition-all duration-300 ease-bounce shadow-card-md"
          >
            @komandro_ccit
            <i class="bx bx-right-arrow-alt text-[19px]" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
