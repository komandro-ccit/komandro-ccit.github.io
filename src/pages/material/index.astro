---
import Layout from '../../layouts/Layout.astro';
import CategoryCard from '../../components/material/CategoryCard.astro';
import HeroBg from '../../components/ui/HeroBg.astro';
import { CATEGORIES } from '../../data/categories';

const categoryOrder = ['mobile', 'web', 'ui-ux', 'devops', 'qa', 'iot', 'tools', 'game'];
const categories = categoryOrder.map((slug) => ({ slug, ...CATEGORIES[slug] }));
---

<Layout title="Sumber Belajar - Komandro CCIT-FTUI">
  <main class="min-h-screen bg-canvas pt-[92px]">
    {/* Hero */}
    <section class="relative py-20 md:py-28 overflow-hidden bg-canvas hero-pattern border-b border-ink/6">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Sumber Belajar</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            Pilih <span class="relative text-violet">Jalur Belajar</span><svg class="absolute" aria-hidden="true" style="display:none"></svg>
          </h1>
          <p class="text-body-lg text-ink-2 max-w-xl">
            Kuasai domain teknis yang dibutuhkan untuk membangun masa depan. Pilih spesialisasi di bawah untuk mengakses materi belajar terstruktur.
          </p>
        </div>
      </div>
    </section>

    {/* Grid Kategori */}
    <section class="py-14 md:py-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {categories.map((cat) => (
          <CategoryCard slug={cat.slug} />
        ))}
      </div>
    </section>
  </main>
</Layout>
