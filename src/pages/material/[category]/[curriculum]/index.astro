---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import SeriesStepper from '../../../../components/material/SeriesStepper.astro';
import Pill from '../../../../components/ui/Pill.astro';
import { link } from '../../../../utils/link';
import { categoryOf, DIFFICULTY_TONE, DIFFICULTY_LABEL, ACCENT_BG } from '../../../../data/categories';

export async function getStaticPaths() {
  const materials = await getCollection('materials');
  
  const curriculumSlugs = new Set<string>();
  
  materials.forEach(material => {
    const slugParts = material.slug.split('/');
    if (slugParts.length >= 3) {
      const category = slugParts[0];
      const curriculumName = slugParts[1];
      curriculumSlugs.add(`${category}/${curriculumName}`);
    }
  });
  
  return Array.from(curriculumSlugs).map(slug => {
    const [category, curriculum] = slug.split('/');
    return {
      params: { category, curriculum },
      props: { curriculumSlug: slug }
    };
  });
}

const { category, curriculum } = Astro.params;
const { curriculumSlug } = Astro.props;
const cat = categoryOf(category);
const accent = cat.tone;

const allMaterials = await getCollection('materials');

// Get curriculum index
const curriculumIndex = allMaterials.find(m => 
  m.slug === `${curriculumSlug}/index` || m.slug === curriculumSlug
);

// Get all lessons for this curriculum
const lessons = allMaterials
  .filter(m => {
    const slugParts = m.slug.split('/');
    return slugParts.length === 3 && 
           slugParts[0] === category && 
           slugParts[1] === curriculum &&
           slugParts[2] !== 'index';
  })
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Fallback if curriculum index not found
const curriculumData = curriculumIndex?.data || {
  title: curriculum.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
  description: 'Complete learning curriculum',
  difficulty: 'Beginner',
  author: 'Komandro Team',
  estimatedTime: 'TBD',
  pubDate: new Date().toISOString()
};

// Map lessons to modules for stepper
const modules = lessons.map((lesson, index) => ({
  title: lesson.data.title,
  description: lesson.data.description,
  status: index === 0 ? 'active' as const : 'future' as const,
  lessons: [{
    title: lesson.data.title,
    slug: lesson.slug.split('/').pop()?.replace('.mdx', '') || ''
  }]
}));

const activeModuleIndex = 0;
---

<Layout title={`${curriculumData.title} - Komandro CCIT-FTUI`}>
  <main class="min-h-screen bg-canvas pt-[92px]">

    {/* Back nav */}
    <section class="relative py-10 overflow-hidden bg-canvas hero-pattern border-b border-ink/6">
      <span class="pointer-events-none absolute -top-24 right-[-60px] w-[300px] h-[300px] rounded-full bg-violet opacity-[.14] blur-[90px]" aria-hidden="true"></span>
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <a href={link(`/material/${category}`)} class="inline-flex items-center gap-2 bg-white text-ink-2 hover:text-violet px-4 h-10 rounded-full text-[13.5px] font-bold shadow-card transition-colors">
          <i class="bx bx-arrow-back text-[17px]" aria-hidden="true"></i>
          Kembali ke {cat.label}
        </a>
      </div>
    </section>

    {/* Kartu Kurikulum */}
    <section class="px-margin-mobile md:px-margin-desktop -mt-5 relative z-20 max-w-container-max mx-auto pb-8">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg overflow-hidden shadow-card-md relative">
          <div class:list={['h-1.5', ACCENT_BG[accent]]} aria-hidden="true"></div>

          <div class="p-7 md:p-9">
            <div class="flex flex-wrap items-center gap-2.5 mb-5">
              <Pill label="SERI" tone={accent} />

              {curriculumData.difficulty && (
                <Pill label={DIFFICULTY_LABEL[curriculumData.difficulty] ?? curriculumData.difficulty} tone={DIFFICULTY_TONE[curriculumData.difficulty] ?? 'neutral'} />
              )}

              {curriculumData.estimatedTime && (
                <Pill label={`${curriculumData.estimatedTime}`} tone="neutral" />
              )}

              <Pill label={`${lessons.length} Materi`} tone="neutral" />
            </div>

            <h1 class="font-display text-display-md md:text-display-lg text-ink mb-4">{curriculumData.title}</h1>

            <p class="text-body-lg text-ink-2 mb-6">{curriculumData.description}</p>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13.5px] font-semibold text-ink-2 mb-6">
              <span class="inline-flex items-center gap-2">
                <i class="bx bx-user text-ink-3" aria-hidden="true"></i>
                {curriculumData.author}
              </span>
              <span class="w-1 h-1 rounded-full bg-ink-3 hidden sm:block" aria-hidden="true"></span>
              <span class="inline-flex items-center gap-2">
                <i class="bx bx-calendar text-ink-3" aria-hidden="true"></i>
                {new Date(curriculumData.pubDate).toLocaleDateString('id-ID', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
            </div>

            {curriculumData.prerequisites && curriculumData.prerequisites.length > 0 && (
              <div class="bg-mint-soft rounded-md p-5">
                <h4 class="text-label uppercase tracking-widest text-mint-deep mb-3">Prasyarat</h4>
                <ul class="space-y-1.5">
                  {curriculumData.prerequisites.map((prereq) => (
                    <li class="flex items-center gap-2 text-body-sm text-ink-2">
                      <i class="bx bx-check text-mint-deep text-[15px]" aria-hidden="true"></i>
                      {prereq}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    {/* Stepper */}
    <section class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-8">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-display text-display-md text-ink">Isi Kurikulum</h2>
          <span class="text-body-sm font-semibold text-ink-2">{lessons.length} Materi</span>
        </div>

        {lessons.length === 0 ? (
          <div class="bg-white rounded-md p-12 text-center shadow-card">
            <div class="w-20 h-20 mx-auto rounded-full bg-violet-soft text-violet grid place-items-center text-[38px] mb-4" aria-hidden="true">
              <i class="bx bx-edit"></i>
            </div>
            <p class="text-ink-2">Materi akan segera ditambahkan!</p>
          </div>
        ) : (
          <SeriesStepper
            modules={modules}
            category={category}
            curriculum={curriculum}
            activeModuleIndex={activeModuleIndex}
            accent={accent}
          />
        )}
      </div>
    </section>
  </main>
</Layout>
