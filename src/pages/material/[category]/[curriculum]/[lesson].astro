---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import ReadingLayout from '../../../../components/material/ReadingLayout.astro';
import { link } from '../../../../utils/link';

export async function getStaticPaths() {
  const materials = await getCollection('materials');
  
  return materials
    .filter(m => {
      const slugParts = m.slug.split('/');
      return slugParts.length === 3 && !m.slug.endsWith('/index');
    })
    .map((material) => {
      const slugParts = material.slug.split('/');
      return {
        params: { 
          category: slugParts[0], 
          curriculum: slugParts[1],
          lesson: slugParts[2]
        },
        props: { material }
      };
    });
}

const { material } = Astro.props;
const { category, curriculum } = Astro.params;

const { Content, headings } = await material.render();

// Get curriculum info
let curriculumInfo = null;
if (curriculum) {
  const allMaterials = await getCollection('materials');
  curriculumInfo = allMaterials.find(m => 
    m.slug === `${category}/${curriculum}/index`
  );
}

const backUrl = `/material/${category}/${curriculum}`;
const backLabel = `Kembali ke Kurikulum`;

// Build TOC from h2/h3 headings
const tocItems = headings
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({
    text: h.text,
    href: `#${h.slug}`
  }));

// Get prev/next lessons for navigation
const allMaterials = await getCollection('materials');
const curriculumLessons = allMaterials
  .filter(m => {
    const parts = m.slug.split('/');
    return parts.length === 3 && parts[0] === category && parts[1] === curriculum && parts[2] !== 'index';
  })
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = curriculumLessons.findIndex(l => l.slug === material.slug);
const prevLesson = currentIndex > 0 ? curriculumLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < curriculumLessons.length - 1 ? curriculumLessons[currentIndex + 1] : null;

const prevSlug = prevLesson?.slug.split('/').pop()?.replace('.mdx', '');
const nextSlug = nextLesson?.slug.split('/').pop()?.replace('.mdx', '');
---

<Layout title={`${material.data.title} - Komandro CCIT-FTUI`}>
  <ReadingLayout
    title={material.data.title}
    description={material.data.description}
    backUrl={backUrl}
    backLabel={backLabel}
    type="LESSON"
    author={material.data.author}
    pubDate={material.data.pubDate}
    estimatedTime={material.data.estimatedTime}
    tocItems={tocItems}
    prerequisites={material.data.prerequisites}
    tags={material.data.tags}
  >
    <Content />
    
    <div slot="navigation" class="mt-14 pt-8 border-t border-ink/8 grid grid-cols-2 gap-4">
      {prevLesson && prevSlug ? (
        <a href={link(`/material/${category}/${curriculum}/${prevSlug}`)} class="group bg-sky-soft rounded-md p-5 md:p-6 hover:shadow-card-md transition-all duration-300 ease-bounce hover:-translate-y-0.5 min-w-0">
          <span class="flex items-center gap-2 text-[12.5px] font-bold uppercase tracking-widest text-sky-deep mb-2">
            <i class="bx bx-arrow-back text-[15px]" aria-hidden="true"></i> Sebelumnya
          </span>
          <span class="font-display text-[17px] leading-snug text-ink group-hover:text-sky-deep transition-colors block">{prevLesson.data.title}</span>
        </a>
      ) : (
        <span></span>
      )}
      {nextLesson && nextSlug ? (
        <a href={link(`/material/${category}/${curriculum}/${nextSlug}`)} class="group bg-violet-soft rounded-md p-5 md:p-6 hover:shadow-card-md transition-all duration-300 ease-bounce hover:-translate-y-0.5 text-right min-w-0">
          <span class="flex items-center justify-end gap-2 text-[12.5px] font-bold uppercase tracking-widest text-violet-deep mb-2">
            Selanjutnya <i class="bx bx-right-arrow-alt text-[15px]" aria-hidden="true"></i>
          </span>
          <span class="font-display text-[17px] leading-snug text-ink group-hover:text-violet-deep transition-colors block">{nextLesson.data.title}</span>
        </a>
      ) : (
        <span></span>
      )}
    </div>
  </ReadingLayout>
</Layout>
