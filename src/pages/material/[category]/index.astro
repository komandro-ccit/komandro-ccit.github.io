---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SingleMaterialCard from '../../../components/material/SingleMaterialCard.astro';
import SeriesMaterialCard from '../../../components/material/SeriesMaterialCard.astro';
import IconBadge from '../../../components/ui/IconBadge.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import HeroBg from '../../../components/ui/HeroBg.astro';
import { link } from '../../../utils/link';
import { categoryOf } from '../../../data/categories';

export async function getStaticPaths() {
  const categories = ['web', 'mobile', 'ui-ux', 'qa', 'devops', 'iot', 'game', 'tools'];
  return categories.map(cat => ({ params: { category: cat } }));
}

const { category } = Astro.params;
const info = categoryOf(category);
const accentMap: Record<string, 'violet' | 'pink' | 'mint' | 'amber' | 'sky' | 'lime' | 'orange' | 'magenta'> = {
  mobile: 'violet', web: 'sky', 'ui-ux': 'pink', qa: 'amber',
  devops: 'mint', iot: 'lime', game: 'magenta', tools: 'orange'
};
const accent = accentMap[category] ?? 'violet';

const allMaterials = await getCollection('materials');

// Get materials for this category
const categoryMaterials = allMaterials.filter(m => 
  m.slug.startsWith(category + '/')
);

// Group materials
const curriculums: typeof categoryMaterials = [];
const standaloneArticles: typeof categoryMaterials = [];
const curriculumLessons: Record<string, typeof categoryMaterials> = {};

categoryMaterials.forEach(material => {
  const slugParts = material.slug.split('/');
  const isCurriculum = material.data.type === 'curriculum';
  
  if (isCurriculum) {
    curriculums.push(material);
  } else if (slugParts.length === 2) {
    standaloneArticles.push(material);
  } else if (slugParts.length >= 3) {
    const curriculumName = slugParts[1];
    if (!curriculumLessons[curriculumName]) {
      curriculumLessons[curriculumName] = [];
    }
    curriculumLessons[curriculumName].push(material);
  }
});

// Sort curriculum lessons by order
Object.keys(curriculumLessons).forEach(key => {
  curriculumLessons[key].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
});

const totalItems = curriculums.length + standaloneArticles.length;
---

<Layout title={`${info.label} - Materi - Komandro CCIT-FTUI`}>
  <main class="min-h-screen bg-canvas pt-[92px]">

    {/* Hero */}
    <section class="relative py-16 md:py-24 overflow-hidden bg-canvas hero-pattern border-b border-ink/6">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-4xl">
          <a href={link('/material')} class="inline-flex items-center gap-2 bg-white text-ink-2 hover:text-violet mb-8 px-4 h-10 rounded-full text-[13.5px] font-bold transition-colors shadow-card">
            <i class="bx bx-arrow-back text-[17px]" aria-hidden="true"></i>
            Semua Jalur
          </a>

          <IconBadge icon={info.icon} accent={accent} size="lg" class="mb-6" />

          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-4">
            {info.label}
          </h1>
          <p class="text-body-lg text-ink-2 max-w-2xl mb-8">
            {info.description}
          </p>

          <div class="flex flex-wrap gap-3">
            <div class="inline-flex items-center gap-2 bg-white px-5 h-10 rounded-full shadow-card text-[13.5px] font-semibold text-ink-2">
              <span class="font-bold text-ink">{curriculums.length}</span> Kurikulum
            </div>
            <div class="inline-flex items-center gap-2 bg-white px-5 h-10 rounded-full shadow-card text-[13.5px] font-semibold text-ink-2">
              <span class="font-bold text-ink">{standaloneArticles.length}</span> Artikel
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Konten */}
    <section class="py-14 md:py-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">

      {/* Kurikulum */}
      {curriculums.length > 0 && (
        <div class="mb-16">
          <SectionHeader
            kicker="Belajar Bertahap"
            accent={accent === 'mint' ? 'sky' : 'mint'}
            title="Kurikulum Terstruktur"
          />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {curriculums.map((curriculum) => {
              const slugParts = curriculum.slug.split('/');
              const curriculumSlug = slugParts[slugParts.length - 1];
              const lessons = curriculumLessons[curriculumSlug] || [];
              const lessonTitles = lessons.slice(0, 4).map(l => l.data.title);

              return (
                <SeriesMaterialCard
                  href={link(`/material/${category}/${curriculumSlug}`)}
                  title={curriculum.data.title}
                  description={curriculum.data.description}
                  moduleCount={lessons.length}
                  modules={lessonTitles}
                  difficulty={curriculum.data.difficulty}
                  accent={accent}
                />
              );
            })}
          </div>
        </div>
      )}

      {/* Artikel Tunggal */}
      {standaloneArticles.length > 0 && (
        <div>
          <SectionHeader
            kicker="Baca Cepat"
            accent={accent === 'pink' ? 'violet' : 'pink'}
            title="Artikel Tunggal"
          />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {standaloneArticles.map((article) => {
              const articleSlug = article.slug.split('/').pop()?.replace('.mdx', '');
              return (
                <SingleMaterialCard
                  href={link(`/material/${category}/${articleSlug}`)}
                  title={article.data.title}
                  description={article.data.description}
                  author={article.data.author}
                  date={new Date(article.data.pubDate).toLocaleDateString('id-ID', { month: 'short', year: 'numeric' })}
                  difficulty={article.data.difficulty}
                  accent={accent}
                />
              );
            })}
          </div>
        </div>
      )}

      {totalItems === 0 && (
        <div class="text-center py-20 bg-white rounded-md shadow-card">
          <div class="w-20 h-20 mx-auto rounded-full bg-violet-soft text-violet grid place-items-center text-[40px] mb-5" aria-hidden="true">
            <i class="bx bx-book-open"></i>
          </div>
          <h3 class="font-display text-display-sm text-ink mb-2">Belum Ada Materi</h3>
          <p class="text-ink-2">Materi untuk jalur ini akan segera ditambahkan!</p>
        </div>
      )}
    </section>
  </main>
</Layout>
