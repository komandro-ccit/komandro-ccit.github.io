---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/ui/CTA.astro';
import HeroBg from '../../components/ui/HeroBg.astro';
import { link } from '../../utils/link';

const posts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<Layout title="Blog - Komandro CCIT-FTUI">
  <main class="pt-[92px]">

    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Blog</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            <span class="text-violet">Cerita &amp;</span> Wawasan
          </h1>
          <p class="text-body-lg text-ink-2 max-w-xl">
            Berita, pembaruan, dan wawasan dari komunitas Komandro.
          </p>
        </div>
      </div>
    </section>

    {/* Artikel */}
    <section class="py-14 md:py-20 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        {sortedPosts.length === 0 ? (
          <div class="text-center py-20 bg-canvas rounded-md shadow-card">
            <div class="w-20 h-20 mx-auto rounded-full bg-violet-soft text-violet grid place-items-center text-[38px] mb-5" aria-hidden="true">
              <i class="bx bx-file-blank"></i>
            </div>
            <h2 class="font-display text-display-sm text-ink mb-2">Belum Ada Artikel</h2>
            <p class="text-ink-2 text-body-md">Artikel akan segera dipublikasikan!</p>
          </div>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            {sortedPosts.map((post) => (
              <article class="group bg-canvas rounded-md overflow-hidden shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
                {post.data.heroImage && (
                  <div class="p-3 pb-0">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full aspect-video object-cover rounded-[16px]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}

                <div class="p-6">
                  <div class="flex items-center gap-2.5 mb-4 text-[12.5px] font-semibold text-ink-3">
                    <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}</span>
                    <span class="w-1 h-1 rounded-full bg-ink-3" aria-hidden="true"></span>
                    <span>{post.data.author}</span>
                  </div>

                  <a href={link(`/blog/${post.slug}`)}>
                    <h2 class="font-display text-[19px] leading-snug text-ink mb-3 group-hover:text-violet transition-colors">
                      {post.data.title}
                    </h2>
                  </a>

                  <p class="text-body-sm text-ink-2 mb-5 line-clamp-2">{post.data.description}</p>

                  <a
                    href={link(`/blog/${post.slug}`)}
                    class="inline-flex items-center gap-2 text-[13.5px] font-bold text-violet"
                  >
                    Baca Selengkapnya
                    <i class="bx bx-right-arrow-alt text-[16px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
