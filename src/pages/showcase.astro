---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import CTA from '../components/ui/CTA.astro';
import HeroBg from '../components/ui/HeroBg.astro';
import { link } from '../utils/link';

const projects = [
  {
    id: 1,
    title: "E-Commerce Mobile App Redesign",
    description: "Complete UI/UX redesign for a local e-commerce platform focusing on improving user experience and conversion rates through modern design principles.",
    type: "design",
    url: "https://figma.com/example-ecommerce",
    author: "Sarah Wijaya",
    batch: "2022",
    image: "/images/showcase/ecommerce-design.jpg"
  },
  {
    id: 2,
    title: "Task Management API",
    description: "RESTful API built with Node.js and Express for managing tasks and projects. Features authentication, real-time updates, and comprehensive documentation.",
    type: "code",
    url: "https://github.com/example/task-api",
    author: "Ahmad Fauzi",
    batch: "2023",
    image: "/images/showcase/task-api.jpg"
  },
  {
    id: 3,
    title: "Healthcare Dashboard Design",
    description: "Modern dashboard design for healthcare management system with data visualization, patient tracking, and appointment scheduling features.",
    type: "design",
    url: "https://figma.com/example-healthcare",
    author: "Maya Putri",
    batch: "2021",
    image: "/images/showcase/healthcare-dashboard.jpg"
  },
  {
    id: 4,
    title: "Social Media Analytics Tool",
    description: "Python-based analytics tool for tracking social media metrics across multiple platforms. Includes data visualization and automated reporting.",
    type: "code",
    url: "https://github.com/example/social-analytics",
    author: "Reza Pratama",
    batch: "2022",
    image: "/images/showcase/analytics-tool.jpg"
  },
  {
    id: 5,
    title: "Banking App UI Kit",
    description: "Comprehensive UI kit for banking applications including 50+ screens, design system, and component library for rapid prototyping.",
    type: "design",
    url: "https://figma.com/example-banking-kit",
    author: "Dewi Anggraini",
    batch: "2023",
    image: "/images/showcase/banking-kit.jpg"
  },
  {
    id: 6,
    title: "Weather Forecast App",
    description: "Flutter weather application with real-time data, location services, and beautiful animations. Integrates with OpenWeatherMap API.",
    type: "code",
    url: "https://github.com/example/weather-app",
    author: "Budi Santoso",
    batch: "2021",
    image: "/images/showcase/weather-app.jpg"
  }
];

const designProjects = projects.filter(p => p.type === 'design');
const codeProjects = projects.filter(p => p.type === 'code');
---

<Layout title="Showcase - Komandro CCIT-FTUI"
  description="Showcase of amazing projects by Komandro alumni. Discover innovative designs and code repositories from our talented community members.">
  <main class="pt-24">
    
    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Karya</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            <span class="text-pink">Karya</span> Komunitas
          </h1>
          <p class="text-body-lg text-ink-2 max-w-2xl">
            Wadah karya terbaik anggota Komandro — sedang dalam pembaruan.
          </p>
        </div>
      </div>
    </section>

    {/* Konten disementara disembunyikan — kartu disimpan sebagai referensi (lihat git history) */}

    {/* Empty state — konten disembunyikan sementara; kartu-kartu proyek lama tersimpan sebagai referensi (lihat git history) */}
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="bg-canvas rounded-lg p-12 md:p-16 text-center shadow-card max-w-2xl mx-auto">
          <div class="w-20 h-20 mx-auto rounded-[24px] bg-pink-soft grid place-items-center mb-6" aria-hidden="true">
            <i class="bx bx-wrench text-pink text-[38px]"></i>
          </div>
          <h2 class="font-display text-display-md text-ink mb-3">Sedang Diperbarui</h2>
          <p class="text-body-md text-ink-2 mb-8 max-w-md mx-auto">
            Koleksi karya anggota sedang kami siapkan. Datang lagi nanti ya!
          </p>
          <CTA href="/" label="Kembali ke Beranda" variant="ghost" arrow />
        </div>
      </div>
    </section>
  </main>  </main>
</Layout>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
