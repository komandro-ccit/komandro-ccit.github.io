---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import HeroBg from '../components/ui/HeroBg.astro';
import { link } from '../utils/link';

const projects = [
  {
    id: 1,
    title: "E-Commerce Mobile App Redesign",
    description: "Complete UI/UX redesign for a local e-commerce platform focusing on improving user experience and conversion rates through modern design principles.",
    type: "design",
    url: "https://figma.com/example-ecommerce",
    author: "Sarah Wijaya",
    batch: "2022",
    image: "/images/showcase/ecommerce-design.jpg"
  },
  {
    id: 2,
    title: "Task Management API",
    description: "RESTful API built with Node.js and Express for managing tasks and projects. Features authentication, real-time updates, and comprehensive documentation.",
    type: "code",
    url: "https://github.com/example/task-api",
    author: "Ahmad Fauzi",
    batch: "2023",
    image: "/images/showcase/task-api.jpg"
  },
  {
    id: 3,
    title: "Healthcare Dashboard Design",
    description: "Modern dashboard design for healthcare management system with data visualization, patient tracking, and appointment scheduling features.",
    type: "design",
    url: "https://figma.com/example-healthcare",
    author: "Maya Putri",
    batch: "2021",
    image: "/images/showcase/healthcare-dashboard.jpg"
  },
  {
    id: 4,
    title: "Social Media Analytics Tool",
    description: "Python-based analytics tool for tracking social media metrics across multiple platforms. Includes data visualization and automated reporting.",
    type: "code",
    url: "https://github.com/example/social-analytics",
    author: "Reza Pratama",
    batch: "2022",
    image: "/images/showcase/analytics-tool.jpg"
  },
  {
    id: 5,
    title: "Banking App UI Kit",
    description: "Comprehensive UI kit for banking applications including 50+ screens, design system, and component library for rapid prototyping.",
    type: "design",
    url: "https://figma.com/example-banking-kit",
    author: "Dewi Anggraini",
    batch: "2023",
    image: "/images/showcase/banking-kit.jpg"
  },
  {
    id: 6,
    title: "Weather Forecast App",
    description: "Flutter weather application with real-time data, location services, and beautiful animations. Integrates with OpenWeatherMap API.",
    type: "code",
    url: "https://github.com/example/weather-app",
    author: "Budi Santoso",
    batch: "2021",
    image: "/images/showcase/weather-app.jpg"
  }
];

const designProjects = projects.filter(p => p.type === 'design');
const codeProjects = projects.filter(p => p.type === 'code');

const typeBadgeStyles: Record<string, string> = {
  'design': 'bg-primary text-white',
  'code': 'bg-secondary text-white',
};
---

<Layout title="Showcase - Komandro CCIT-FTUI"
  description="Showcase of amazing projects by Komandro alumni. Discover innovative designs and code repositories from our talented community members.">
  <main class="pt-24">
    
    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Karya</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            <span class="text-pink">Karya</span> Komunitas
          </h1>
          <p class="text-body-lg text-ink-2 max-w-2xl">
            Karya-karya keren dari alumni Komandro. Temukan desain inovatif dan repositori kode dari anggota komunitas kami yang berbakat.
          </p>
        </div>
      </div>
    </section>

    {/* Ringkasan */}
    <section class="py-14 md:py-20 bg-canvas">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="flex items-center gap-4 bg-pink-soft rounded-md px-7 py-6 shadow-card">
            <IconBadge icon="bx-palette" accent="pink" />
            <div>
              <div class="font-display text-display-md text-ink">{designProjects.length}</div>
              <div class="text-[12px] font-bold uppercase tracking-widest text-pink-deep">Proyek Desain</div>
            </div>
          </div>

          <div class="flex items-center gap-4 bg-sky-soft rounded-md px-7 py-6 shadow-card">
            <IconBadge icon="bx-code-alt" accent="sky" />
            <div>
              <div class="font-display text-display-md text-ink">{codeProjects.length}</div>
              <div class="text-[12px] font-bold uppercase tracking-widest text-sky-deep">Proyek Kode</div>
            </div>
          </div>

          <div class="flex items-center gap-4 bg-violet-soft rounded-md px-7 py-6 shadow-card">
            <IconBadge icon="bx-collection" accent="violet" />
            <div>
              <div class="font-display text-display-md text-ink">{projects.length}</div>
              <div class="text-[12px] font-bold uppercase tracking-widest text-violet-deep">Total Proyek</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Proyek Desain */}
    {designProjects.length > 0 && (
      <section class="py-16 md:py-24 bg-white">
        <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
          <SectionHeader
            kicker="Karya Desain"
            accent="pink"
            title="Proyek Desain"
          />

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            {designProjects.map((project) => (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-canvas rounded-md overflow-hidden shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce"
              >
                <div class="p-3 pb-0">
                  <div class="aspect-video rounded-[16px] relative overflow-hidden bg-pink-soft">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={project.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <i class="bx bx-image text-pink text-[48px]" aria-hidden="true"></i>
                      </div>
                    )}

                    <span class="absolute top-3 right-3 px-3 h-7 inline-flex items-center rounded-full bg-pink text-white text-[11.5px] font-bold uppercase tracking-widest">
                      Desain
                    </span>
                  </div>
                </div>

                <div class="p-6">
                  <h3 class="font-display text-[19px] text-ink mb-2 group-hover:text-pink transition-colors line-clamp-1">
                    {project.title}
                  </h3>

                  <p class="text-body-sm text-ink-2 mb-5 line-clamp-3">
                    {project.description}
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-ink/6">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full bg-pink-soft grid place-items-center text-pink-deep text-[13px] font-bold" aria-hidden="true">
                        {project.author.charAt(0)}
                      </div>
                      <div class="text-body-sm">
                        <div class="text-ink font-bold">{project.author}</div>
                        <div class="text-ink-3">Batch {project.batch}</div>
                      </div>
                    </div>

                    <span class="inline-flex items-center gap-1 text-[13.5px] font-bold text-pink" aria-hidden="true">
                      Lihat
                      <i class="bx bx-right-arrow-alt text-[15px] transition-transform group-hover:translate-x-1"></i>
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Proyek Kode */}
    {codeProjects.length > 0 && (
      <section class="py-16 md:py-24 bg-canvas">
        <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
          <SectionHeader
            kicker="Open Source"
            accent="sky"
            title="Proyek Kode"
          />

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            {codeProjects.map((project) => (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-white rounded-md overflow-hidden shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce"
              >
                <div class="p-3 pb-0">
                  <div class="aspect-video rounded-[16px] relative overflow-hidden bg-ink-band">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={project.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <i class="bx bx-code-block text-white/30 text-[48px]" aria-hidden="true"></i>
                      </div>
                    )}

                    <span class="absolute top-3 right-3 px-3 h-7 inline-flex items-center rounded-full bg-sky text-white text-[11.5px] font-bold uppercase tracking-widest">
                      Kode
                    </span>
                  </div>
                </div>
                
                <div class="p-6">
                  <h3 class="font-display text-[19px] text-ink mb-2 group-hover:text-sky-deep transition-colors line-clamp-1">
                    {project.title}
                  </h3>

                  <p class="text-body-sm text-ink-2 mb-5 line-clamp-3">
                    {project.description}
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-ink/6">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full bg-sky-soft grid place-items-center text-sky-deep text-[13px] font-bold" aria-hidden="true">
                        {project.author.charAt(0)}
                      </div>
                      <div class="text-body-sm">
                        <div class="text-ink font-bold">{project.author}</div>
                        <div class="text-ink-3">Batch {project.batch}</div>
                      </div>
                    </div>

                    <span class="inline-flex items-center gap-1 text-[13.5px] font-bold text-sky" aria-hidden="true">
                      GitHub
                      <i class="bx bx-right-arrow-alt text-[15px] transition-transform group-hover:translate-x-1"></i>
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Pembaruan Rutin */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="bg-amber-soft rounded-lg p-10 md:p-16 text-center shadow-card">
          <div class="w-20 h-20 mx-auto rounded-[24px] bg-white shadow-card-md grid place-items-center mb-6" aria-hidden="true">
            <i class="bx bx-time text-amber-deep text-[38px]"></i>
          </div>
          <h2 class="font-display text-display-md text-ink mb-4">Pembaruan Rutin</h2>
          <p class="text-body-lg text-ink-2 max-w-2xl mx-auto">
            Karya diperbarui di akhir setiap periode batch. Tunggu karya baru dari setiap angkatan yang tamat!
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
