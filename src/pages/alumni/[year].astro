---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import AlumniCard from '../../components/AlumniCard.astro';
import CTA from '../../components/ui/CTA.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { link } from '../../utils/link';

interface Alumni {
  id: string;
  name: string;
  role: string;
  batch: number;
  photo?: string;
  consent: boolean;
  currentPosition?: string;
  contact?: {
    email?: string;
    linkedin?: string;
  };
  achievements?: string[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  const alumniFiles = import.meta.glob('/src/data/alumni/*.json', { eager: true });
  const currentYear = new Date().getFullYear();
  const allYears = Array.from({ length: currentYear - 2013 }, (_, i) => 2014 + i);

  const alumniMap: Record<string, Alumni[]> = {};
  for (const [path, data] of Object.entries(alumniFiles)) {
    const yearMatch = path.match(/(\d{4})\.json$/);
    if (!yearMatch) continue;
    const alumniData = data as { default: Alumni[] };
    alumniMap[yearMatch[1]] = alumniData.default || alumniData;
  }

  return allYears.map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      alumni: alumniMap[String(year)] || []
    }
  }));
};

interface Props {
  year: number;
  alumni: Alumni[];
}

const { year, alumni } = Astro.props;

const sortedAlumni = [...alumni].sort((a, b) => {
  const roleOrder = ['Ketua', 'Wakil Ketua', 'Sekretaris', 'Bendahara', 'Pengurus', 'Anggota'];
  const aIndex = roleOrder.indexOf(a.role);
  const bIndex = roleOrder.indexOf(b.role);
  return aIndex - bIndex;
});

const currentYear = new Date().getFullYear();
const maxBatchYear = currentYear - 2;
const availableYears = Array.from({ length: maxBatchYear - 2013 }, (_, i) => 2014 + i).reverse();
---

<Layout title={`Alumni Batch ${year} - Komandro CCIT-FTUI`}>
  <main class="pt-[92px]">
    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-14 md:py-20">
      <span class="pointer-events-none absolute -top-24 right-[-60px] w-[320px] h-[320px] rounded-full bg-pink opacity-[.13] blur-[90px]" aria-hidden="true"></span>
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-4xl">
          <a href={link('/alumni')} class="inline-flex items-center gap-2 bg-white text-ink-2 hover:text-violet mb-7 px-4 h-10 rounded-full text-[13.5px] font-bold shadow-card transition-colors">
            <i class="bx bx-left-arrow-alt text-[17px]" aria-hidden="true"></i>
            Kembali ke Alumni
          </a>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            Alumni Batch <span class="text-violet">{year}</span>
          </h1>
          <p class="text-body-lg text-ink-2 max-w-2xl">
            Perkenalkan anggota berbakat yang membentuk Komandro CCIT-FTUI pada {year}.
          </p>
        </div>
      </div>
    </section>

    {/* Navigasi Tahun */}
    <section class="py-4 sticky top-[84px] z-40">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="bg-white/90 backdrop-blur-md rounded-full shadow-nav px-5 py-3 inline-flex items-center gap-3 max-w-full">
          <label for="year-filter" class="text-[12.5px] font-bold uppercase tracking-widest text-ink-3 whitespace-nowrap">
            Tahun:
          </label>
          <select
            id="year-filter"
            class="bg-transparent text-[14.5px] font-bold text-ink cursor-pointer focus:outline-none"
          >
            {availableYears.map((yr) => (
              <option value={link(`/alumni/${yr}`)} selected={yr === year}>{yr}</option>
            ))}
          </select>
        </div>
      </div>
    </section>

    {/* Grid Alumni */}
    <section class="py-12 md:py-16 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="mb-10 md:mb-12">
        <h2 class="font-display text-display-md text-ink">{alumni.length} Anggota</h2>
        <p class="text-ink-2 text-body-md mt-1">Angkatan {year}</p>
      </div>

      {alumni.length === 0 ? (
        <div class="text-center py-20 bg-white rounded-md shadow-card">
          <div class="w-20 h-20 mx-auto rounded-full bg-canvas grid place-items-center text-[38px] text-ink-3 mb-5" aria-hidden="true">
            <i class="bx bx-user-x"></i>
          </div>
          {year > maxBatchYear ? (
            <>
              <h3 class="font-display text-display-sm text-ink mb-2">Angkatan ini masih berjalan</h3>
              <p class="text-ink-2 text-body-md max-w-md mx-auto">
                Batch {year} saat ini masih aktif sebagai mahasiswa dan belum menjadi alumni.
              </p>
            </>
          ) : (
            <>
              <h3 class="font-display text-display-sm text-ink mb-2">Belum Ada Data Alumni</h3>
              <p class="text-ink-2 text-body-md max-w-md mx-auto">
                Belum ada data alumni untuk batch {year}. Datanya mungkin belum tersedia.
              </p>
            </>
          )}
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {sortedAlumni.map((person) => (
            <AlumniCard
              alumni={person}
            />
          ))}
        </div>
      )}
    </section>

    {/* CTA */}
    <section class="pb-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="relative overflow-hidden bg-gradient-to-br from-violet to-pink rounded-lg px-8 md:px-12 py-14 text-center text-white">
          <span class="pointer-events-none absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/12" aria-hidden="true"></span>
          <span class="pointer-events-none absolute -bottom-20 -left-12 w-56 h-56 rounded-full bg-white/10" aria-hidden="true"></span>
          <h2 class="relative font-display text-display-md md:text-display-lg mb-4 text-white">Jadilah Bagian dari Cerita Kami</h2>
          <p class="relative text-white/85 text-body-lg mb-9 max-w-2xl mx-auto">
            bergabung Komandro CCIT-FTUI dan menjadi generasi penerus pemimpin teknologi.
          </p>
          <CTA href="/" label="Gabung Sekarang" variant="white" arrow class="relative" />
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.getElementById('year-filter')?.addEventListener('change', (e) => {
    window.location.href = (e.target as HTMLSelectElement).value;
  });
</script>
