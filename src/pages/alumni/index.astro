---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CTA from '../../components/ui/CTA.astro';
import HeroBg from '../../components/ui/HeroBg.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import Pill from '../../components/ui/Pill.astro';
import { link } from '../../utils/link';

const currentYear = new Date().getFullYear();
const maxBatchYear = currentYear - 2;
const availableYears = Array.from({ length: maxBatchYear - 2013 }, (_, i) => 2014 + i).reverse();

const getYearDescription = (year: number): string => {
  if (year === 2015) return 'Tahun Berdiri';
  if (year === maxBatchYear) return 'Angkatan Terbaru';
  return `Batch ${year - 2014}`;
};

const yearAccents = ['violet', 'pink', 'mint', 'amber', 'sky', 'magenta', 'orange', 'lime'] as const;

const featured = [
  {
    initials: 'HR',
    name: 'Muhamad Hudya Ramadhana',
    role: 'Lead Backend Engineer',
    batch: 'Batch 2015',
    href: 'https://linkedin.com/in/perogeremmer',
    accent: 'violet' as const
  },
  {
    initials: 'NS',
    name: 'Natasha Syeikinah Marsauli',
    role: 'Product Manager',
    batch: 'Batch 2018',
    href: 'https://www.linkedin.com/in/natassm/',
    accent: 'pink' as const
  },
  {
    initials: 'TY',
    name: 'Tivo Yudha Perwira',
    role: 'Lead Frontend Engineer',
    batch: 'Batch 2015',
    href: 'https://www.linkedin.com/in/tivo-yudha/',
    accent: 'mint' as const
  }
];

const avatarBg: Record<string, string> = {
  violet: 'bg-violet',
  pink: 'bg-pink',
  mint: 'bg-mint'
};

const softBg: Record<string, string> = {
  violet: 'bg-violet-soft', pink: 'bg-pink-soft', mint: 'bg-mint-soft',
  amber: 'bg-amber-soft', sky: 'bg-sky-soft', magenta: 'bg-magenta-soft',
  orange: 'bg-orange-soft', lime: 'bg-lime-soft'
};
const deepText: Record<string, string> = {
  violet: 'text-violet-deep', pink: 'text-pink-deep', mint: 'text-mint-deep',
  amber: 'text-amber-deep', sky: 'text-sky-deep', magenta: 'text-magenta-deep',
  orange: 'text-orange-deep', lime: 'text-lime-deep'
};
---

<Layout title="Alumni - Komandro CCIT-FTUI">
  <main class="pt-[92px]">

    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Alumni</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            Direktori <span class="text-violet">Alumni</span>
          </h1>
          <p class="text-body-lg text-ink-2 max-w-xl">
            {availableYears.length} angkatan alumni berbakat yang telah membentuk perjalanan Komandro sejak 2015.
          </p>
        </div>
      </div>
    </section>

    {/* Alumni Unggulan */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Hall of Fame"
          accent="pink"
          title="Alumni Unggulan"
          description="Alumni yang memberikan dampak besar pada komunitas Komandro."
          align="center"
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {featured.map((f) => (
            <div class="bg-canvas rounded-md p-8 text-center shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
              <div class:list={['w-20 h-20 mx-auto mb-6 rounded-[20px] grid place-items-center shadow-card-md', avatarBg[f.accent]]} aria-hidden="true">
                <span class="font-display text-[24px] text-white">{f.initials}</span>
              </div>
              <h3 class="font-display text-lg text-ink mb-1.5">{f.name}</h3>
              <p class="text-[12.5px] font-bold uppercase tracking-widest text-violet mb-4">{f.role}</p>
              <Pill label={f.batch} tone="neutral" />
              <a href={f.href} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-1.5 text-[13.5px] font-bold text-ink-2 hover:text-violet transition-colors">
                <i class="bx bxl-linkedin text-[16px]" aria-hidden="true"></i>
                LinkedIn
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Pilih Tahun Angkatan */}
    <section class="py-16 md:py-24 bg-canvas">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <SectionHeader
          kicker="Direktori"
          accent="violet"
          title="Pilih Tahun Angkatan"
          description="Klik tahun mana pun untuk melihat alumni yang menjadi bagian dari angkatan itu."
        />

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {availableYears.map((year, i) => {
            const accent = yearAccents[i % yearAccents.length];
            return (
              <a
                href={link(`/alumni/${year}`)}
                class:list={['group rounded-md p-6 text-center shadow-card hover:shadow-card-md hover:-translate-y-1 hover:scale-[1.03] transition-all duration-300 ease-bounce', softBg[accent]]}
              >
                <div class="font-display text-[26px] md:text-[30px] text-ink mb-1.5">{year}</div>
                <div class:list={['text-[11.5px] font-bold uppercase tracking-widest', deepText[accent]]}>{getYearDescription(year)}</div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {/* Study Turtle */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="flex flex-col lg:flex-row justify-between items-start gap-12">
          <div class="lg:w-1/2">
            <SectionHeader
              kicker="Program Alumni"
              accent="amber"
              title="Study Turtle (Stutle)"
            />
            <p class="text-body-md text-ink-2 leading-relaxed mb-4 -mt-3">
              Semua alumni yang tamat dari CCIT-FTUI dan mantan anggota Komandro otomatis menjadi bagian dari Study Turtle (Stutle) — organisasi alumni eksklusif yang didedikasikan untuk pertumbuhan berkelanjutan dan pengembangan profesional.
            </p>
            <p class="text-body-md text-ink-2 leading-relaxed mb-8">
              Stutle menyediakan program komprehensif untuk meningkatkan kapabilitas alumni Komandro di dunia profesional, termasuk mentoring satu lawan satu, pendampingan karier, peluang networking, dan workshop industri.
            </p>
            <CTA href="/alumni/2015" label="Jelajahi Jaringan Alumni" variant="primary" arrow />
          </div>

          <div class="lg:w-1/2 flex items-center justify-center w-full">
            <div class="bg-mint-soft rounded-lg p-12 w-full max-w-md aspect-square flex items-center justify-center">
              <div class="text-center">
                <div class="w-24 h-24 mx-auto rounded-[24px] bg-white shadow-card-md grid place-items-center mb-6" aria-hidden="true">
                  <i class="bx bx-group text-mint-deep text-[44px]"></i>
                </div>
                <div class="font-display text-display-sm text-ink mb-2">Study Turtle</div>
                <div class="text-body-sm text-ink-2 mb-1">Organisasi Alumni</div>
                <div class="text-body-sm text-ink-2 font-semibold">Mentoring · Berkembang · Sukses</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
