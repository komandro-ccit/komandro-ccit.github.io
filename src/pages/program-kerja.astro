---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CTA from '../components/ui/CTA.astro';
import HeroBg from '../components/ui/HeroBg.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Pill from '../components/ui/Pill.astro';
import programData from '../data/program-kerja.json';

const { programs } = programData;

const statusTone: Record<string, { label: string; tone: 'mint' | 'neutral' | 'sky' }> = {
  active: { label: 'Aktif', tone: 'mint' },
  completed: { label: 'Selesai', tone: 'neutral' },
  planned: { label: 'Direncanakan', tone: 'sky' },
};

const categoryIcons: Record<string, string> = {
  'Pendidikan': 'bx-book-open',
  'Kompetisi': 'bx-trophy',
  'Keorganisasian': 'bx-group',
  'Pameran': 'bx-slideshow',
};

const categoryAccents: Record<string, 'violet' | 'sky' | 'mint' | 'amber' | 'pink' | 'magenta'> = {
  'Pendidikan': 'violet',
  'Kompetisi': 'amber',
  'Keorganisasian': 'mint',
  'Pameran': 'pink',
};
---

<Layout title="Program Kerja - Komandro CCIT-FTUI">
  <main class="pt-[92px]">

    {/* Hero */}
    <section class="relative overflow-hidden bg-canvas hero-pattern border-b border-ink/6 py-16 md:py-24">
      <HeroBg />
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 mb-7 shadow-card">
            <span class="w-2 h-2 rounded-full bg-violet" aria-hidden="true"></span>
            <span class="text-[13px] font-semibold text-ink-2">Program Kami</span>
          </div>
          <h1 class="font-display text-[40px] leading-[1.08] tracking-tight md:text-display-xl text-ink mb-5">
            Program <span class="text-violet">Kerja</span>
          </h1>
          <p class="text-body-lg text-ink-2 max-w-xl">
            Daftar program kerja Komandro CCIT-FTUI yang aktif, selesai, dan yang akan datang.
          </p>
        </div>
      </div>
    </section>

    {/* Grid Program */}
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {programs.map((program) => {
            const status = statusTone[program.status] || statusTone.active;
            const icon = categoryIcons[program.category] || 'bx-folder';
            const accent = categoryAccents[program.category] || 'violet';
            return (
              <div class="bg-canvas rounded-md p-6 shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce flex flex-col">
                <div class="flex items-start justify-between mb-5">
                  <IconBadge icon={icon} accent={accent} />
                  <Pill label={status.label} tone={status.tone} />
                </div>

                <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold uppercase tracking-widest text-ink-3 mb-2.5 w-fit">
                  <span class:list={['w-2 h-2 rounded-full', {
                    violet: 'bg-violet', sky: 'bg-sky', mint: 'bg-mint', amber: 'bg-amber', pink: 'bg-pink', magenta: 'bg-magenta'
                  }[accent]]} aria-hidden="true"></span>
                  {program.category}
                </span>

                <h3 class="font-display text-display-sm text-ink mb-2">{program.name}</h3>
                <p class="text-body-sm text-ink-2 leading-relaxed flex-1">{program.description}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="pb-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="relative overflow-hidden bg-gradient-to-br from-mint to-sky rounded-lg px-8 md:px-12 py-14 text-center text-white">
          <span class="pointer-events-none absolute -top-16 -right-16 w-64 h-64 rounded-full bg-white/15" aria-hidden="true"></span>
          <h2 class="relative font-display text-display-md md:text-display-lg mb-4 text-white">Punya Ide Program Baru?</h2>
          <p class="relative text-white/90 text-body-lg mb-9 max-w-xl mx-auto">
            Kami terbuka untuk masukan dan kolaborasi dari semua anggota.
          </p>
          <a
            href="mailto:komandro@ccit-ftui.ac.id"
            class="relative inline-flex items-center gap-2 bg-white text-mint-deep px-7 py-3.5 rounded-full text-[15px] font-bold hover:-translate-y-0.5 transition-all duration-300 ease-bounce shadow-card-md"
          >
            Hubungi Kami
            <i class="bx bx-right-arrow-alt text-[19px]" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
