---
import { link } from '../../utils/link';
import { DIFFICULTY_TONE, DIFFICULTY_LABEL } from '../../data/categories';
import Pill from '../ui/Pill.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  author: string;
  date: string;
  difficulty?: string;
  accent?: 'violet' | 'pink' | 'mint' | 'amber' | 'sky' | 'lime' | 'orange' | 'magenta';
}

const { href, title, description, author, date, difficulty, accent = 'violet' } = Astro.props;
---

<a
  href={link(href)}
  class="group bg-white rounded-md p-6 flex flex-col gap-3 shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce"
>
  <div class="flex justify-between items-start pt-1">
    {difficulty && (
      <Pill label={DIFFICULTY_LABEL[difficulty] ?? difficulty} tone={DIFFICULTY_TONE[difficulty] ?? 'neutral'} />
    )}
    <Pill label="TUTORIAL" tone="neutral" />
  </div>

  <h3 class="font-display text-display-sm text-ink group-hover:text-violet transition-colors">{title}</h3>
  <p class="text-body-sm text-ink-2 line-clamp-2">{description}</p>

  <div class="flex items-center gap-2.5 mt-auto pt-3.5 border-t border-ink/6">
    <i class="bx bx-user text-ink-3 text-[15px]" aria-hidden="true"></i>
    <span class="text-[12.5px] font-semibold text-ink-2">{author}</span>
    <span class="w-1 h-1 rounded-full bg-ink-3" aria-hidden="true"></span>
    <span class="text-[12.5px] font-semibold text-ink-2">{date}</span>
  </div>
</a>
