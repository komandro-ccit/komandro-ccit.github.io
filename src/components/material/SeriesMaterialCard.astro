---
import { link } from '../../utils/link';
import { DIFFICULTY_TONE, DIFFICULTY_LABEL } from '../../data/categories';
import Pill from '../ui/Pill.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  moduleCount: number;
  modules: string[];
  difficulty?: string;
  accent?: 'violet' | 'pink' | 'mint' | 'amber' | 'sky' | 'lime' | 'orange' | 'magenta';
}

const { href, title, description, moduleCount, modules, difficulty, accent = 'violet' } = Astro.props;
---

<a
  href={link(href)}
  class="group bg-white rounded-md p-6 flex flex-col gap-3.5 shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce relative overflow-hidden"
>
  <span class:list={['absolute top-0 left-0 w-full h-1.5', {
      violet: 'bg-violet', pink: 'bg-pink', mint: 'bg-mint', amber: 'bg-amber',
      sky: 'bg-sky', lime: 'bg-lime', orange: 'bg-orange', magenta: 'bg-magenta'
    }[accent]]} aria-hidden="true"></span>

  <div class="flex justify-between items-start pt-1.5">
    <span class="text-[13px] font-semibold text-ink-3">{moduleCount} Modul</span>
    <Pill label="SERI" tone={accent} />
  </div>

  <h3 class="font-display text-display-sm text-ink group-hover:text-violet transition-colors">{title}</h3>

  {modules.length > 0 && (
    <ul class="text-body-sm text-ink-2 space-y-1.5 mb-3">
      {modules.slice(0, 3).map((mod) => (
        <li class="flex items-start gap-2">
          <i class:list={['bx bx-check-circle mt-0.5 text-[16px]', `text-${accent}`]} aria-hidden="true"></i>
          <span>{mod}</span>
        </li>
      ))}
    </ul>
  )}
  {!modules.length && description && (
    <p class="text-body-sm text-ink-2 line-clamp-2 mb-3">{description}</p>
  )}

  <div class="mt-auto flex items-center justify-between pt-3.5 border-t border-ink/6">
    {difficulty && <Pill label={DIFFICULTY_LABEL[difficulty] ?? difficulty} tone={DIFFICULTY_TONE[difficulty] ?? 'neutral'} />}
    <span class="inline-flex items-center gap-1 text-[13.5px] font-bold text-violet">
      Mulai Belajar
      <i class="bx bx-right-arrow-alt text-[16px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
    </span>
  </div>
</a>
