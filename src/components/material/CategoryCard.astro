---
import { categoryOf } from '../../data/categories';
import MaterialIcon from '../material/MaterialIcon.astro';
import { link } from '../../utils/link';

interface Props {
  slug: string;
  featured?: boolean;
}

const { slug, featured = false } = Astro.props;
const cat = categoryOf(slug);
---

<a
  href={link(`/material/${cat.slug}`)}
  class:list={[
    'group block rounded-lg p-6 text-white relative overflow-hidden flex flex-col h-full transition-all duration-300 ease-bounce hover:-translate-y-1.5 hover:rotate-[-0.6deg] hover:shadow-hover',
    cat.bg,
    featured && 'md:col-span-2 lg:col-span-1 xl:col-span-2'
  ]}
>
  <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/12 group-hover:scale-125 transition-transform duration-500 ease-bounce" aria-hidden="true"></div>
  <div class="w-12 h-12 rounded-[16px] bg-white/25 grid place-items-center text-[24px] mb-4 relative" aria-hidden="true">
    <MaterialIcon name={cat.icon} />
  </div>
  <h3 class="relative font-display text-display-sm text-white mb-2">{cat.label}</h3>
  <p class="relative text-body-sm text-white/90 mb-4 flex-grow leading-relaxed">
    {cat.description}
  </p>
  <div class="relative mt-auto">
    <span class="inline-flex items-center gap-1.5 bg-white/20 backdrop-blur px-4 h-9 rounded-full text-[13px] font-bold text-white">
      Lihat Materi
      <i class="bx bx-right-arrow-alt text-[16px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
    </span>
  </div>
</a>
