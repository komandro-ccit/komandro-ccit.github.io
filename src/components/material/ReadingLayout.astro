---
import ImageLightbox from '../ImageLightbox.astro';
import { link } from '../../utils/link';

interface TocItem {
  text: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  backUrl: string;
  backLabel: string;
  type?: string;
  author: string;
  pubDate: string;
  estimatedTime?: string;
  tocItems: TocItem[];
  prerequisites?: string[];
  tags?: string[];
}

const {
  title,
  description,
  backUrl,
  backLabel,
  type = 'LESSON',
  author,
  pubDate,
  estimatedTime,
  tocItems,
  prerequisites,
  tags
} = Astro.props;

const tagTones = [
  'bg-violet-soft text-violet-deep',
  'bg-mint-soft text-mint-deep',
  'bg-amber-soft text-amber-deep',
  'bg-sky-soft text-sky-deep',
  'bg-pink-soft text-pink-deep'
];
---

<main class="min-h-screen bg-canvas pt-[100px]">
  {/* Content Grid */}
  <div class="max-w-container-max mx-auto px-4 md:px-6 pb-16 pt-8 grid grid-cols-1 lg:grid-cols-12 gap-6">
    {/* Main Content */}
    <main class="lg:col-span-9 bg-white rounded-lg shadow-card p-5 md:p-10">
      {/* Header */}
      <div class="mb-lg border-b border-outline-variant pb-md">
        <div class="flex justify-between items-center mb-8">
          <a href={link(backUrl)} class="inline-flex items-center gap-2 bg-canvas text-ink-2 hover:text-violet px-4 h-10 rounded-full text-[13.5px] font-bold transition-colors">
            <i class="bx bx-arrow-back text-[17px]" aria-hidden="true"></i>
            {backLabel}
          </a>

          <span class="inline-flex px-3.5 h-8 items-center rounded-full bg-violet-soft text-violet-deep text-[12px] font-bold uppercase tracking-widest">
            {type.toUpperCase()}
          </span>
        </div>

        <h1 class="font-display text-display-md md:text-display-lg text-ink mb-5">{title}</h1>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 text-[13.5px] font-semibold text-ink-2">
          <span class="inline-flex items-center gap-2">
            <i class="bx bx-user text-ink-3 text-[16px]" aria-hidden="true"></i>
            {author}
          </span>
          <span class="w-1 h-1 rounded-full bg-ink-3" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-2">
            <i class="bx bx-calendar text-ink-3 text-[16px]" aria-hidden="true"></i>
            {new Date(pubDate).toLocaleDateString('id-ID', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </span>
          {estimatedTime && (
            <span class="inline-flex items-center gap-2">
              <i class="bx bx-time text-ink-3 text-[16px]" aria-hidden="true"></i>
              {estimatedTime}
            </span>
          )}
        </div>
      </div>
      
      {prerequisites && prerequisites.length > 0 && (
        <div class="mb-8 p-6 bg-mint-soft rounded-md">
          <h3 class="text-label uppercase tracking-widest text-mint-deep mb-3">Prasyarat</h3>
          <ul class="space-y-2">
            {prerequisites.map((prereq) => (
              <li class="flex items-center gap-2 text-body-sm text-ink-2">
                <i class="bx bx-check text-mint-deep text-[16px]" aria-hidden="true"></i>
                {prereq}
              </li>
            ))}
          </ul>
        </div>
      )}
      
      {/* Article Body */}
      <article class="prose prose-lg max-w-none text-body-lg text-ink space-y-6
        prose-headings:text-ink
        prose-headings:font-display
        prose-headings:font-semibold
        prose-h1:text-[30px] prose-h1:mb-6 prose-h1:mt-8 prose-h1:tracking-tight
        prose-h2:text-[24px] prose-h2:mb-4 prose-h2:mt-8 prose-h2:tracking-tight prose-h2:scroll-mt-28
        prose-h3:text-[20px] prose-h3:mb-3 prose-h3:mt-6 prose-h3:tracking-tight prose-h3:scroll-mt-28
        prose-h4:text-[17px] prose-h4:mb-2 prose-h4:mt-4
        prose-p:text-ink-2 prose-p:mb-4
        prose-a:text-violet prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
        prose-strong:text-ink prose-strong:font-semibold
        prose-ul:list-disc prose-ul:ml-6 prose-ul:mb-4
        prose-ol:list-decimal prose-ol:ml-6 prose-ol:mb-4
        prose-li:text-ink-2 prose-li:mb-1.5 prose-li:marker:text-violet
        prose-table:mb-6
        prose-th:bg-soft prose-th:text-ink prose-th:font-semibold prose-th:p-3 prose-th:text-left prose-th:border prose-th:border-ink/10
        prose-td:p-3 prose-td:border prose-td:border-ink/10 prose-td:text-ink-2
        prose-blockquote:border-l-4 prose-blockquote:border-violet prose-blockquote:bg-soft prose-blockquote:rounded-r-[14px] prose-blockquote:pl-5 prose-blockquote:py-3 prose-blockquote:pr-5 prose-blockquote:mb-6 prose-blockquote:not-italic
        prose-img:mb-6 prose-img:rounded-[18px] prose-img:shadow-card-md prose-img:cursor-zoom-in prose-img:border-0
        prose-hr:border-ink/10 prose-hr:my-8
        prose-pre:bg-[#10161A] prose-pre:p-0 prose-pre:relative prose-pre:rounded-[18px]
        prose-code:text-violet-deep prose-code:bg-soft prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-[6px] prose-code:font-normal
      ">
        <slot />
      </article>
      
      {tags && tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-ink/8">
          <h3 class="text-label uppercase tracking-widest text-ink-3 mb-3">Tag</h3>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag, i) => (
              <span class:list={['px-3.5 h-[28px] inline-flex items-center rounded-full text-[12px] font-bold', tagTones[i % tagTones.length]]}>
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}
      
      {/* Prev/Next Navigation */}
      <slot name="navigation" />
    </main>
    
    {/* Sidebar TOC */}
    <aside class="hidden lg:block lg:col-span-3">
      <div class="sticky top-[100px] bg-white rounded-md shadow-card p-6">
        <h3 class="font-display text-[17px] text-ink mb-4 pb-3 border-b border-ink/8">Di Halaman Ini</h3>
        <nav class="flex flex-col gap-0.5 text-[14px]" id="toc-nav">
          {tocItems.map((item, index) => (
            <a
              href={item.href}
              class:list={[
                'border-l-2 pl-3.5 py-[5px] transition-colors',
                index === 0 ? 'text-violet border-violet font-bold' : 'text-ink-2 border-transparent hover:text-violet'
              ]}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>
</main>

<ImageLightbox />

<style is:global>
  .prose pre {
    background-color: #10161A !important;
    color: #d4d4d4 !important;
    padding: 0 !important;
    border-radius: 1rem;
    overflow-x: auto;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose pre code {
    background-color: transparent !important;
    color: inherit !important;
    padding: 0;
  }

  .prose pre .shiki {
    background-color: transparent !important;
  }

  .prose pre > code {
    display: block;
    padding: 1.25rem 1.5rem;
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.25rem;
    background-color: #1B2229;
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: #999;
    user-select: none;
  }

  .code-block-header .lang-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .code-block-header .copy-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    font-size: 0.75rem;
    font-family: inherit;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    transition: color 0.15s, background 0.15s;
  }

  .code-block-header .copy-btn:hover {
    color: #e0e0e0;
    background: rgba(255,255,255,0.08);
  }

  .code-block-header .copy-btn.copied {
    color: #3DDC84;
  }

  .prose :not(pre) > code {
    color: #4A2FCC;
    background-color: #F6F2FF;
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .mermaid {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
    padding: 1rem;
    background: #FFF9F3;
    border: 1px solid rgba(42, 35, 64, 0.08);
    border-radius: 1rem;
    overflow-x: auto;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
  }

  .table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--color-outline-variant, #e0e0e0);
    border-radius: 0.375rem;
  }
  .prose table {
    min-width: 900px;
    width: max-content;
    border-collapse: collapse;
    margin: 0;
  }
</style>

<script>
  // TOC IntersectionObserver
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        if (!id) return;
        const tocLink = document.querySelector(`#toc-nav a[href="#${id}"]`);
        
        if (entry.isIntersecting && tocLink) {
          document.querySelectorAll('#toc-nav a').forEach(a => {
            a.classList.remove('text-violet', 'border-violet', 'font-bold');
            a.classList.add('text-ink-2', 'border-transparent');
          });
          tocLink.classList.remove('text-ink-2', 'border-transparent');
          tocLink.classList.add('text-violet', 'border-violet', 'font-bold');
        }
      });
    }, { rootMargin: '-100px 0px -66% 0px' });

    document.querySelectorAll('article h2, article h3').forEach((section) => {
      if (section.id) observer.observe(section);
    });
  });
  
  // Mermaid rendering
  document.addEventListener('DOMContentLoaded', async () => {
    const mermaidPres = document.querySelectorAll('pre[data-language="mermaid"]');
    if (mermaidPres.length === 0) return;

    function decodeHtml(str) {
      const txt = document.createElement('textarea');
      txt.innerHTML = str;
      return txt.value;
    }

    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, theme: 'default' });

    for (let i = 0; i < mermaidPres.length; i++) {
      const pre = mermaidPres[i];
      let text = pre.textContent || '';
      text = decodeHtml(decodeHtml(text));

      const container = document.createElement('div');
      container.classList.add('mermaid');
      container.textContent = text;
      pre.replaceWith(container);
    }

    await mermaid.run({ nodes: document.querySelectorAll('.mermaid') });
  });

  // Code block header with language label and copy button
  function initCodeBlocks() {
    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.getAttribute('data-language') === 'mermaid') return;
      if (pre.dataset.codeblockReady) return;
      pre.dataset.codeblockReady = 'true';

      const code = pre.querySelector('code');
      const lang = code?.className?.match(/language-(\w+)/)?.[1] || 'code';
      const codeText = code?.textContent || pre.textContent || '';

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const label = document.createElement('span');
      label.className = 'lang-label';
      label.textContent = lang;

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy';

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(codeText);
          btn.classList.add('copied');
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy';
          }, 2000);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = codeText;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
      });

      header.appendChild(label);
      header.appendChild(btn);
      pre.insertBefore(header, pre.firstChild);
    });
  }

  document.addEventListener('DOMContentLoaded', initCodeBlocks);
  document.addEventListener('astro:page-load', initCodeBlocks);

  // Wrap tables in scrollable divs
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.prose table').forEach((table) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'table-wrapper';
      if (table.parentNode) {
        table.parentNode.insertBefore(wrapper, table);
      }
      wrapper.appendChild(table);
    });
  });
</script>
