---
import { link } from '../../utils/link';
import type { AccentName } from '../../data/categories';

interface Lesson {
  title: string;
  slug: string;
}

interface Module {
  title: string;
  description: string;
  status: 'completed' | 'active' | 'future';
  lessons: Lesson[];
}

interface Props {
  modules: Module[];
  category: string;
  curriculum: string;
  activeModuleIndex?: number;
  accent?: AccentName;
}

const { modules, category, curriculum, activeModuleIndex = 0, accent = 'violet' } = Astro.props;
---

<div class="relative space-y-md ml-xs lg:ml-0">
  {modules.map((mod, index) => {
    const isLast = index === modules.length - 1;
    const isActive = index === activeModuleIndex;
    const isCompleted = index < activeModuleIndex;
    const href = link(`/material/${category}/${curriculum}/${mod.lessons[0]?.slug || ''}`);
    
    return (
      <div class:list={['relative flex gap-5 items-start group', `accent-${accent}`]}>
        {!isLast && <div class="path-line" />}

        {/* Indikator langkah */}
        <div class:list={[
          'relative z-10 w-9 h-9 rounded-full flex items-center justify-center shrink-0 mt-1.5 transition-colors',
          isCompleted
            ? 'bg-white border-[3px] border-violet'
            : isActive
              ? 'bg-white border-[3px] border-violet shadow-[0_0_0_6px_rgba(108,77,246,0.14)]'
              : 'bg-white border-2 border-ink/12'
        ]}>
          {isCompleted && <span class="w-4 h-4 rounded-full bg-violet" />}
          {isActive && <span class="w-2.5 h-2.5 rounded-full bg-violet" />}
        </div>

        {/* Kartu modul — seluruh kartu adalah tautan */}
        <a href={href} class:list={[
          'flex-1 block bg-white rounded-md p-5 md:p-6 transition-all duration-300 ease-bounce shadow-card hover:shadow-card-md hover:-translate-y-0.5',
          isActive ? 'ring-2 ring-violet/60' : 'hover:ring-2 hover:ring-violet/30'
        ]}>
          <div class="flex justify-between items-center mb-2.5">
            <h3 class="font-display text-[19px] text-ink group-hover:text-violet transition-colors">{mod.title}</h3>
            <i class="bx bx-right-arrow-alt text-ink-3 text-[20px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
          </div>
          <p class="text-body-sm text-ink-2">{mod.description}</p>
        </a>
      </div>
    );
  })}
</div>

<style>
  .path-line {
    width: 3px;
    border-radius: 999px;
    background-color: rgba(108, 77, 246, 0.18);
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: -40px;
    z-index: 0;
  }
</style>
