---
---

<div id="image-lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Image lightbox" style="display:none;">
  <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
  <div class="lightbox-container">
    <img class="lightbox-img" src="" alt="" draggable="false" />
  </div>
</div>

<style>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .lightbox-overlay.active {
    opacity: 1;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    color: #fff;
    font-size: 36px;
    line-height: 1;
    cursor: pointer;
    z-index: 10001;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .lightbox-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 0.15s ease-out;
    will-change: transform;
  }

  .lightbox-img.dragging {
    cursor: grabbing;
    transition: none;
  }

  .lightbox-img.zoomed-in {
    cursor: grab;
  }
</style>

<script>
  function initLightbox() {
    const overlay = document.getElementById('image-lightbox');
    if (!overlay) return;

    const container = overlay.querySelector('.lightbox-container') as HTMLElement;
    const img = overlay.querySelector('.lightbox-img') as HTMLImageElement;
    const closeBtn = overlay.querySelector('.lightbox-close') as HTMLButtonElement;

    if (!container || !img || !closeBtn) return;

    let scale = 1;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let startTranslateX = 0;
    let startTranslateY = 0;

    function updateTransform() {
      img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
    }

    function resetState() {
      scale = 1;
      translateX = 0;
      translateY = 0;
      updateTransform();
      img.classList.remove('zoomed-in');
    }

    function openLightbox(src: string, alt: string) {
      img.src = src;
      img.alt = alt || '';
      resetState();
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        overlay.classList.add('active');
      });
    }

    function closeLightbox() {
      overlay.classList.remove('active');
      setTimeout(() => {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
        resetState();
      }, 250);
    }

    // Attach click to all prose images
    document.querySelectorAll('.prose img').forEach((proseImg) => {
      proseImg.setAttribute('role', 'button');
      proseImg.setAttribute('tabindex', '0');
      proseImg.setAttribute('aria-label', 'Click to zoom image');

      const handler = () => {
        const el = proseImg as HTMLImageElement;
        openLightbox(el.src, el.alt);
      };

      proseImg.addEventListener('click', handler);
      proseImg.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          handler();
        }
      });
    });

    // Close handlers
    closeBtn.addEventListener('click', closeLightbox);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay || e.target === container) {
        closeLightbox();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (overlay.style.display === 'none' || overlay.style.display === '') return;
      if (e.key === 'Escape') closeLightbox();
    });

    // Prevent image click from closing (only close on backdrop click)
    img.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // ---- Pan (drag) ----
    function onPointerDown(e: PointerEvent) {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      startTranslateX = translateX;
      startTranslateY = translateY;
      img.classList.add('dragging');
      img.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      e.preventDefault();
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      translateX = startTranslateX + dx;
      translateY = startTranslateY + dy;
      updateTransform();
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      img.classList.remove('dragging');
      img.releasePointerCapture(e.pointerId);
    }

    container.addEventListener('pointerdown', onPointerDown);
    container.addEventListener('pointermove', onPointerMove);
    container.addEventListener('pointerup', onPointerUp);
    container.addEventListener('pointercancel', onPointerUp);

    // ---- Scroll zoom ----
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? -0.15 : 0.15;
      const newScale = Math.min(5, Math.max(1, scale + delta));

      if (newScale === scale) return;

      // Zoom toward cursor position
      const rect = img.getBoundingClientRect();
      const imgCenterX = rect.left + rect.width / 2;
      const imgCenterY = rect.top + rect.height / 2;
      const offsetX = e.clientX - imgCenterX;
      const offsetY = e.clientY - imgCenterY;

      const ratio = newScale / scale;
      translateX = translateX + offsetX * (1 - ratio);
      translateY = translateY + offsetY * (1 - ratio);

      scale = newScale;

      if (scale <= 1.01) {
        scale = 1;
        translateX = 0;
        translateY = 0;
        img.classList.remove('zoomed-in');
      } else {
        img.classList.add('zoomed-in');
      }

      updateTransform();
    }, { passive: false });

    // ---- Double-click to toggle zoom ----
    container.addEventListener('dblclick', (e) => {
      e.preventDefault();
      if (scale > 1.01) {
        scale = 1;
        translateX = 0;
        translateY = 0;
        img.classList.remove('zoomed-in');
      } else {
        scale = 2;
        img.classList.add('zoomed-in');

        const rect = img.getBoundingClientRect();
        const imgCenterX = rect.left + rect.width / 2;
        const imgCenterY = rect.top + rect.height / 2;
        translateX = (e.clientX - imgCenterX) * -1;
        translateY = (e.clientY - imgCenterY) * -1;
      }
      updateTransform();
    });

    // ---- Touch pinch zoom ----
    let lastTouchDistance = 0;
    let lastTouchMidpoint = { x: 0, y: 0 };

    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 2) {
        e.preventDefault();
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        lastTouchDistance = Math.sqrt(dx * dx + dy * dy);
        lastTouchMidpoint = {
          x: (e.touches[0].clientX + e.touches[1].clientX) / 2,
          y: (e.touches[0].clientY + e.touches[1].clientY) / 2,
        };
      }
    }, { passive: false });

    container.addEventListener('touchmove', (e) => {
      if (e.touches.length === 2) {
        e.preventDefault();
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        const distance = Math.sqrt(dx * dx + dy * dy);
        const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
        const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;

        const delta = distance / lastTouchDistance;
        const newScale = Math.min(5, Math.max(1, scale * delta));

        if (newScale !== scale) {
          const rect = img.getBoundingClientRect();
          const imgCenterX = rect.left + rect.width / 2;
          const imgCenterY = rect.top + rect.height / 2;
          const ratio = newScale / scale;
          const offsetX = midX - imgCenterX;
          const offsetY = midY - imgCenterY;

          translateX = translateX + offsetX * (1 - ratio);
          translateY = translateY + offsetY * (1 - ratio);

          scale = newScale;

          if (scale <= 1.01) {
            scale = 1;
            translateX = 0;
            translateY = 0;
            img.classList.remove('zoomed-in');
          } else {
            img.classList.add('zoomed-in');
          }
        }

        translateX += midX - lastTouchMidpoint.x;
        translateY += midY - lastTouchMidpoint.y;

        lastTouchDistance = distance;
        lastTouchMidpoint = { x: midX, y: midY };

        updateTransform();
      }
    }, { passive: false });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initLightbox);

  // Re-initialize for Astro view transitions
  document.addEventListener('astro:page-load', initLightbox);
</script>
