---
interface Alumni {
  id: string;
  name: string;
  role: string;
  batch: number;
  photo?: string;
  consent: boolean;
  currentPosition?: string;
  contact?: {
    email?: string;
    linkedin?: string;
  };
  achievements?: string[];
}

interface Props {
  alumni: Alumni;
}

const { alumni } = Astro.props;

const roleTone: Record<string, 'violet' | 'sky' | 'mint' | 'amber' | 'neutral'> = {
  'Ketua': 'violet',
  'Wakil Ketua': 'sky',
  'Sekretaris': 'mint',
  'Bendahara': 'amber',
  'Pengurus': 'neutral',
  'Anggota': 'neutral'
};

const accentPool = ['violet', 'pink', 'mint', 'sky', 'amber', 'magenta', 'orange', 'lime'] as const;
const seed = alumni.name.split('').reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
const accent = accentPool[seed % accentPool.length];

const avatarBg: Record<string, string> = {
  violet: 'bg-violet',
  pink: 'bg-pink',
  mint: 'bg-mint',
  sky: 'bg-sky',
  amber: 'bg-amber',
  magenta: 'bg-magenta',
  orange: 'bg-orange',
  lime: 'bg-lime'
};

const initials = alumni.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map(w => w[0])
  .join('')
  .toUpperCase();

const defaultAvatar = `https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(alumni.name)}&backgroundColor=6C4DF6&textColor=ffffff`;
---

<article class="group bg-white rounded-md p-5 shadow-card hover:shadow-card-md hover:-translate-y-1 transition-all duration-300 ease-bounce">
  <div class="w-full aspect-square overflow-hidden bg-canvas rounded-[18px] mb-4">
    {alumni.consent === false ? (
      <div class="w-full h-full flex items-center justify-center bg-canvas">
        <i class="bx bx-user-x text-ink-3 text-[56px]" aria-hidden="true"></i>
      </div>
    ) : (
      <img
        src={alumni.photo || defaultAvatar}
        alt={alumni.name}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500 ease-bounce"
      />
    )}
  </div>

  <div class="flex items-start justify-between gap-3 mb-1">
    <h3 class="font-display text-[17px] text-ink leading-snug">{alumni.name}</h3>
  </div>

  {alumni.currentPosition && (
    <p class="text-[12.5px] font-semibold text-ink-2 mb-2">{alumni.currentPosition}</p>
  )}

  <div class="flex flex-wrap items-center gap-2 mb-3">
    <span class:list={['px-3 h-[24px] inline-flex items-center rounded-full text-[11px] font-bold', avatarBg[accent], 'text-white']}>
      {alumni.role}
    </span>
    <span class="text-[11.5px] font-bold text-ink-3 uppercase tracking-widest">Batch {alumni.batch}</span>
  </div>

  {(alumni.contact?.linkedin || alumni.contact?.email) && (
    <div class="flex items-center gap-2 pt-3 border-t border-ink/6">
      {alumni.contact?.linkedin && (
        <a
          href={alumni.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`LinkedIn ${alumni.name}`}
          class="w-9 h-9 rounded-full bg-canvas grid place-items-center text-ink-2 hover:text-violet hover:bg-violet-soft transition-colors"
        >
          <i class="bx bxl-linkedin text-[17px]"></i>
        </a>
      )}
      {alumni.contact?.email && (
        <a
          href={`mailto:${alumni.contact.email}`}
          aria-label={`Email ${alumni.name}`}
          class="w-9 h-9 rounded-full bg-canvas grid place-items-center text-ink-2 hover:text-violet hover:bg-violet-soft transition-colors"
        >
          <i class="bx bx-envelope text-[17px]"></i>
        </a>
      )}
    </div>
  )}

  {alumni.achievements && alumni.achievements.length > 0 && (
    <div class="mt-3 pt-3 border-t border-ink/6">
      <ul class="space-y-1.5">
        {alumni.achievements.slice(0, 2).map((achievement) => (
          <li class="flex items-start gap-1.5 text-[12.5px] text-ink-2">
            <i class="bx bx-trophy text-amber-deep text-[14px] mt-0.5 shrink-0" aria-hidden="true"></i>
            <span>{achievement}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
