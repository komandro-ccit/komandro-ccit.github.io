---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<form data-lookup-form class:list={['w-full', className]} novalidate>
  <label
    for="nim-input"
    class="block text-label uppercase tracking-widest text-ink-2 mb-2"
  >
    Nomor Induk Mahasiswa (NIM)
  </label>

  <div class="flex flex-col sm:flex-row gap-3">
    <div class="relative flex-1">
      <i class="bx bx-id-card absolute left-5 top-1/2 -translate-y-1/2 text-ink-3 text-[20px]" aria-hidden="true"></i>
      <input
        id="nim-input"
        name="nim"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        placeholder="Contoh: 2210512345"
        maxlength="16"
        class:list={[
          'w-full h-[56px] pl-[52px] pr-5 rounded-full bg-white shadow-card',
          'text-body-md text-ink placeholder:text-ink-3/70',
          'outline-none focus:ring-2 focus:ring-violet/60 transition-shadow',
          'font-mono tracking-wider',
        ]}
        aria-describedby="nim-hint"
      />
    </div>

    <button
      type="submit"
      data-lookup-submit
      class:list={[
        'inline-flex items-center justify-center gap-2 h-[56px] px-8 rounded-full',
        'bg-violet text-white font-bold text-[15px] shadow-card-md',
        'hover:bg-violet-deep hover:shadow-card-lg hover:-translate-y-0.5',
        'transition-all duration-300 ease-bounce active:scale-[.98]',
        'disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:translate-y-0',
      ]}
    >
      <i class="bx bx-search text-[18px]" data-lookup-icon aria-hidden="true"></i>
      <span class="hidden sm:inline" data-lookup-label>Cari Kartu</span>
      <span class="sm:hidden">Cari</span>
    </button>
  </div>

  <p id="nim-hint" class="mt-3 text-[13px] text-ink-3">
    NIM terdiri dari 10–11 digit angka. Spasi dan tanda hubung otomatis diabaikan.
  </p>

  {/* Pesan status (dipakai untuk semua state error/sukses) */}
  <div
    data-lookup-status
    role="status"
    aria-live="polite"
    class="mt-4 hidden rounded-md px-5 py-4 text-body-sm"
  >
    <span data-lookup-status-icon class="mr-2" aria-hidden="true"></span>
    <span data-lookup-status-text></span>
  </div>
</form>
