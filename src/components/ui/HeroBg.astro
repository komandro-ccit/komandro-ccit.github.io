---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <span class="absolute -top-32 right-[-80px] w-[380px] h-[380px] rounded-full bg-violet opacity-[.18] blur-[90px] hidden md:block"></span>
  <span class="absolute -bottom-28 left-[-90px] w-[300px] h-[300px] rounded-full bg-pink opacity-[.14] blur-[90px]"></span>
</div>
